---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Q09rxKVzD5GEMNrARkA-hBXzWjBf1wToYDEwQp2fR2k" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C4VSWCY4HC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-C4VSWCY4HC', { send_page_view: false });
    </script>
  </head>
  <body>
    <Header />

    <div class="search-overlay" id="search-overlay" hidden>
      <button class="search-backdrop" id="search-backdrop" aria-label="Fermer la recherche"></button>
      <div class="search-panel" role="dialog" aria-label="Recherche">
        <div class="search-bar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="site-search" type="search" placeholder="Rechercher un article…" autocomplete="off" aria-label="Rechercher" />
          <button class="search-close" id="search-close" aria-label="Fermer">✕</button>
        </div>
        <div class="search-results" id="search-results"><p class="sr-hint">Tape un mot-clé pour chercher dans tous les articles.</p></div>
      </div>
    </div>

    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script>
      function setup() {
        const root = document.documentElement;
        // Google Analytics — 1 vue par page/navigation
        if (window.gtag) window.gtag('event', 'page_view', { page_path: location.pathname + location.search, page_location: location.href, page_title: document.title });
        // Mode sombre
        const tt = document.getElementById('theme-toggle');
        if (tt && !tt.dataset.bound) {
          tt.dataset.bound = '1';
          tt.addEventListener('click', () => {
            const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            const gf = document.querySelector('iframe.giscus-frame');
            if (gf) gf.contentWindow.postMessage({ giscus: { setConfig: { theme: next === 'dark' ? 'dark' : 'light' } } }, 'https://giscus.app');
          });
        }
        // Menu mobile
        const burger = document.getElementById('burger');
        const menu = document.getElementById('menu');
        if (burger && !burger.dataset.bound) { burger.dataset.bound = '1'; burger.addEventListener('click', () => menu && menu.classList.toggle('open')); }
        // Horloge
        if (window.__clock) clearInterval(window.__clock);
        const clock = document.getElementById('clock');
        if (clock) {
          const tick = () => {
            const d = new Date();
            clock.textContent = d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) + '  ' + d.toLocaleTimeString('fr-FR');
          };
          tick(); window.__clock = setInterval(tick, 1000);
        }
        // Rotateur de titres
        if (window.__rot) clearInterval(window.__rot);
        const items = Array.from(document.querySelectorAll('.rot-item'));
        if (items.length) {
          let i = Math.max(0, items.findIndex((el) => el.classList.contains('active')));
          const show = (n) => { items.forEach((el) => el.classList.remove('active')); i = (n + items.length) % items.length; items[i].classList.add('active'); };
          show(i);
          window.__rot = setInterval(() => show(i + 1), 4500);
          document.querySelectorAll('.util .arw').forEach((b) => { if (!b.dataset.bound) { b.dataset.bound = '1'; b.addEventListener('click', () => show(i + Number(b.dataset.dir))); } });
        }
        // Hero slider
        if (window.__slider) clearInterval(window.__slider);
        const slides = Array.from(document.querySelectorAll('.hero-slider .slide'));
        const dots = Array.from(document.querySelectorAll('.hero-slider .dot'));
        if (slides.length) {
          let s = Math.max(0, slides.findIndex((el) => el.classList.contains('active')));
          const go = (n) => {
            s = (n + slides.length) % slides.length;
            slides.forEach((el, k) => { el.classList.toggle('active', k === s); el.setAttribute('aria-hidden', k === s ? 'false' : 'true'); });
            dots.forEach((d, k) => d.classList.toggle('active', k === s));
          };
          const restart = () => { clearInterval(window.__slider); window.__slider = setInterval(() => go(s + 1), 5500); };
          go(s); restart();
          document.querySelectorAll('.hero-slider .hs-nav').forEach((b) => { if (!b.dataset.bound) { b.dataset.bound = '1'; b.addEventListener('click', () => { go(s + Number(b.dataset.slideDir)); restart(); }); } });
          dots.forEach((d) => { if (!d.dataset.bound) { d.dataset.bound = '1'; d.addEventListener('click', () => { go(Number(d.dataset.slideTo)); restart(); }); } });
        }
        // Révélation au scroll
        if (window.__io) window.__io.disconnect();
        const els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && els.length) {
          window.__io = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); window.__io.unobserve(e.target); } });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          els.forEach((el) => window.__io.observe(el));
        } else { els.forEach((el) => el.classList.add('in')); }
        // Formulaires Web3Forms (contact + newsletter)
        document.querySelectorAll('form.w3form').forEach((form) => {
          if (form.dataset.bound) return; form.dataset.bound = '1';
          const msg = form.querySelector('.form-msg');
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"], button');
            const orig = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
            try {
              const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
              const data = await res.json();
              if (msg) msg.textContent = data.success ? (form.dataset.success || '✅ Merci !') : '❌ Oups, réessaie dans un instant.';
              if (data.success) form.reset();
            } catch (err) { if (msg) msg.textContent = '❌ Erreur réseau, réessaie.'; }
            if (btn) { btn.disabled = false; btn.textContent = orig; }
          });
        });
        // Giscus (commentaires) — (ré)injection à chaque navigation
        const gw = document.querySelector('.giscus-wrap');
        if (gw) {
          gw.innerHTML = '';
          const dark = root.getAttribute('data-theme') === 'dark';
          const gs = document.createElement('script');
          const gAttrs = {
            'data-repo': 'moisematondo328/tutoria-blog',
            'data-repo-id': 'R_kgDOTwRb-A',
            'data-category': 'Announcements',
            'data-category-id': 'DIC_kwDOTwRb-M4DC20Z',
            'data-mapping': 'pathname',
            'data-strict': '0',
            'data-reactions-enabled': '1',
            'data-emit-metadata': '0',
            'data-input-position': 'bottom',
            'data-theme': dark ? 'dark' : 'light',
            'data-lang': 'fr',
          };
          gs.src = 'https://giscus.app/client.js';
          Object.entries(gAttrs).forEach(([k, v]) => gs.setAttribute(k, v));
          gs.crossOrigin = 'anonymous';
          gs.async = true;
          gw.appendChild(gs);
        }
        // Recherche / filtre de la page Articles
        const filterInput = document.getElementById('filter');
        if (filterInput) {
          const items = Array.from(document.querySelectorAll('.filter-item'));
          const noresult = document.getElementById('noresult');
          const apply = () => {
            const q = (filterInput.value || '').trim().toLowerCase();
            let shown = 0;
            items.forEach((el) => {
              const ok = !q || (el.dataset.search || '').includes(q);
              el.style.display = ok ? '' : 'none';
              if (ok) shown++;
            });
            if (noresult) noresult.style.display = shown ? 'none' : 'block';
          };
          filterInput.addEventListener('input', apply);
          const clearBtn = document.getElementById('filter-clear');
          if (clearBtn) clearBtn.addEventListener('click', () => { filterInput.value = ''; apply(); filterInput.focus(); });
          const q = new URLSearchParams(location.search).get('q');
          if (q) filterInput.value = q;
          apply();
        }
        // Recherche globale (overlay)
        const overlay = document.getElementById('search-overlay');
        if (overlay) {
          const sInput = document.getElementById('site-search');
          const sResults = document.getElementById('search-results');
          const renderSearch = () => {
            const q = (sInput.value || '').trim().toLowerCase();
            if (!q) { sResults.innerHTML = '<p class="sr-hint">Tape un mot-clé pour chercher dans tous les articles.</p>'; return; }
            const list = (window.__searchIndex || []).filter((a) => (a.title + ' ' + a.excerpt + ' ' + a.category).toLowerCase().includes(q)).slice(0, 25);
            if (!list.length) { sResults.innerHTML = '<p class="sr-hint">Aucun article ne correspond.</p>'; return; }
            sResults.innerHTML = list.map((a) => '<a class="sr-item" href="' + a.url + '"><span class="sr-cat">' + a.category + '</span><span class="sr-title">' + a.title + '</span></a>').join('');
          };
          const openSearch = async () => {
            overlay.hidden = false; document.body.classList.add('no-scroll'); sInput.focus();
            if (!window.__searchIndex) { try { window.__searchIndex = await (await fetch('/search-index.json')).json(); } catch (e) { window.__searchIndex = []; } }
            renderSearch();
          };
          const closeSearch = () => { overlay.hidden = true; document.body.classList.remove('no-scroll'); sInput.value = ''; renderSearch(); };
          sInput.oninput = renderSearch;
          document.getElementById('search-close').onclick = closeSearch;
          document.getElementById('search-backdrop').onclick = closeSearch;
          document.onkeydown = (e) => { if (e.key === 'Escape' && !overlay.hidden) closeSearch(); };
          document.querySelectorAll('[data-search-open]').forEach((b) => { b.onclick = (e) => { e.preventDefault(); openSearch(); }; });
        }
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
