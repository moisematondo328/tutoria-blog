---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Q09rxKVzD5GEMNrARkA-hBXzWjBf1wToYDEwQp2fR2k" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Tutoria News" href="/rss.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tutoria News" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C4VSWCY4HC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-C4VSWCY4HC', { send_page_view: false });
    </script>
  </head>
  <body>
    <Header />

    <div class="search-overlay" id="search-overlay" hidden>
      <button class="search-backdrop" id="search-backdrop" aria-label="Fermer la recherche"></button>
      <div class="search-panel" role="dialog" aria-label="Recherche">
        <div class="search-bar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="site-search" type="search" placeholder="Rechercher un article…" autocomplete="off" aria-label="Rechercher" />
          <button class="search-close" id="search-close" aria-label="Fermer">✕</button>
        </div>
        <div class="search-results" id="search-results"><p class="sr-hint">Tape un mot-clé pour chercher dans tous les articles.</p></div>
      </div>
    </div>

    <div class="nl-popup" id="nl-popup" hidden>
      <button class="nl-popup-backdrop" id="nl-popup-close" aria-label="Fermer"></button>
      <div class="nl-popup-panel">
        <button class="nl-popup-x" id="nl-popup-x" aria-label="Fermer">✕</button>
        <Newsletter />
      </div>
    </div>

    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script>
      function setup() {
        const root = document.documentElement;
        // Google Analytics — 1 vue par page/navigation
        if (window.gtag) window.gtag('event', 'page_view', { page_path: location.pathname + location.search, page_location: location.href, page_title: document.title });
        // Mode sombre
        const tt = document.getElementById('theme-toggle');
        if (tt && !tt.dataset.bound) {
          tt.dataset.bound = '1';
          tt.addEventListener('click', () => {
            const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }
        // Menu mobile
        const burger = document.getElementById('burger');
        const menu = document.getElementById('menu');
        if (burger && !burger.dataset.bound) { burger.dataset.bound = '1'; burger.addEventListener('click', () => menu && menu.classList.toggle('open')); }
        // Horloge
        if (window.__clock) clearInterval(window.__clock);
        const clock = document.getElementById('clock');
        if (clock) {
          const tick = () => {
            const d = new Date();
            clock.textContent = d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) + '  ' + d.toLocaleTimeString('fr-FR');
          };
          tick(); window.__clock = setInterval(tick, 1000);
        }
        // Rotateur de titres
        if (window.__rot) clearInterval(window.__rot);
        const items = Array.from(document.querySelectorAll('.rot-item'));
        if (items.length) {
          let i = Math.max(0, items.findIndex((el) => el.classList.contains('active')));
          const show = (n) => { items.forEach((el) => el.classList.remove('active')); i = (n + items.length) % items.length; items[i].classList.add('active'); };
          show(i);
          window.__rot = setInterval(() => show(i + 1), 4500);
          document.querySelectorAll('.util .arw').forEach((b) => { if (!b.dataset.bound) { b.dataset.bound = '1'; b.addEventListener('click', () => show(i + Number(b.dataset.dir))); } });
        }
        // Hero slider
        if (window.__slider) clearInterval(window.__slider);
        const slides = Array.from(document.querySelectorAll('.hero-slider .slide'));
        const dots = Array.from(document.querySelectorAll('.hero-slider .dot'));
        if (slides.length) {
          let s = Math.max(0, slides.findIndex((el) => el.classList.contains('active')));
          const go = (n) => {
            s = (n + slides.length) % slides.length;
            slides.forEach((el, k) => { el.classList.toggle('active', k === s); el.setAttribute('aria-hidden', k === s ? 'false' : 'true'); });
            dots.forEach((d, k) => d.classList.toggle('active', k === s));
          };
          const restart = () => { clearInterval(window.__slider); window.__slider = setInterval(() => go(s + 1), 5500); };
          go(s); restart();
          document.querySelectorAll('.hero-slider .hs-nav').forEach((b) => { if (!b.dataset.bound) { b.dataset.bound = '1'; b.addEventListener('click', () => { go(s + Number(b.dataset.slideDir)); restart(); }); } });
          dots.forEach((d) => { if (!d.dataset.bound) { d.dataset.bound = '1'; d.addEventListener('click', () => { go(Number(d.dataset.slideTo)); restart(); }); } });
        }
        // Révélation au scroll
        if (window.__io) window.__io.disconnect();
        const els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && els.length) {
          window.__io = new IntersectionObserver((entries) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); window.__io.unobserve(e.target); } });
          }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
          els.forEach((el) => window.__io.observe(el));
        } else { els.forEach((el) => el.classList.add('in')); }
        // Formulaires Web3Forms (contact + newsletter)
        document.querySelectorAll('form.w3form').forEach((form) => {
          if (form.dataset.bound) return; form.dataset.bound = '1';
          const msg = form.querySelector('.form-msg');
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"], button');
            const orig = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
            try {
              const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
              const data = await res.json();
              if (msg) msg.textContent = data.success ? (form.dataset.success || 'Message envoyé, on te répond vite.') : 'Envoi impossible pour le moment. Réessaie.';
              if (data.success) form.reset();
            } catch (err) { if (msg) msg.textContent = 'Connexion perdue. Réessaie dans un instant.'; }
            if (btn) { btn.disabled = false; btn.textContent = orig; }
          });
        });
        // Newsletter Brevo (via la fonction serveur /api/subscribe)
        document.querySelectorAll('form.nl-form').forEach((form) => {
          if (form.dataset.bound) return; form.dataset.bound = '1';
          const msg = form.querySelector('.form-msg');
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"], button');
            const input = form.querySelector('input[type="email"]');
            const orig = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Un instant…'; }
            try {
              const res = await fetch(form.getAttribute('action') || '/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: input ? input.value : '' }),
              });
              const data = await res.json().catch(() => ({}));
              if (data.success) {
                if (msg) msg.textContent = form.dataset.success || 'Merci, tu es inscrit.';
                form.reset();
              } else if (data.error === 'email') {
                if (msg) msg.textContent = 'Vérifie ton adresse e-mail.';
              } else if (data.error === 'config') {
                if (msg) msg.textContent = 'L’inscription n’est pas encore active. Réessaie bientôt.';
              } else {
                if (msg) msg.textContent = 'Inscription impossible pour le moment. Réessaie.';
              }
            } catch (err) { if (msg) msg.textContent = 'Connexion perdue. Réessaie dans un instant.'; }
            if (btn) { btn.disabled = false; btn.textContent = orig; }
          });
        });
        // Commentaires maison (sans compte, pré-modérés) — chargement + envoi
        const cList = document.getElementById('comments-list');
        if (cList) {
          const pid = cList.dataset.pageId;
          const escHtml = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
          fetch('/api/comments?pageId=' + encodeURIComponent(pid))
            .then((r) => r.json())
            .then((d) => {
              const cs = (d && d.comments) || [];
              if (!cs.length) { cList.innerHTML = '<p class="c-empty">Aucun commentaire pour l’instant. Ouvre la discussion.</p>'; return; }
              cList.innerHTML = cs.map((c) => `<div class="c-item"><div class="c-head"><span class="c-name">${escHtml(c.name)}</span><span class="c-date">${new Date(c.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span></div><div class="c-text">${escHtml(c.text)}</div></div>`).join('');
            })
            .catch(() => { cList.innerHTML = '<p class="c-empty">Impossible d’afficher les commentaires pour le moment.</p>'; });
        }
        const cForm = document.getElementById('comment-form');
        if (cForm && !cForm.dataset.bound) {
          cForm.dataset.bound = '1';
          const msg = cForm.querySelector('.c-msg');
          cForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = cForm.querySelector('button[type="submit"]');
            const orig = btn ? btn.textContent : '';
            if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }
            const payload = {
              pageId: cForm.dataset.pageId,
              name: cForm.name.value,
              text: cForm.text.value,
              website: cForm.website.value,
            };
            try {
              const res = await fetch('/api/comments', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
              const d = await res.json().catch(() => ({}));
              if (d.ok) { if (msg) msg.textContent = 'Merci, ton commentaire est reçu. Il apparaîtra après relecture.'; cForm.reset(); }
              else if (d.error === 'champs') { if (msg) msg.textContent = 'Écris ton nom et un message.'; }
              else if (d.error === 'config') { if (msg) msg.textContent = 'Les commentaires ne sont pas encore activés sur le site.'; }
              else { if (msg) msg.textContent = 'Envoi impossible pour le moment. Réessaie.'; }
            } catch (err) { if (msg) msg.textContent = 'Connexion perdue. Réessaie dans un instant.'; }
            if (btn) { btn.disabled = false; btn.textContent = orig; }
          });
        }
        // Recherche / filtre de la page Articles
        const filterInput = document.getElementById('filter');
        if (filterInput) {
          const items = Array.from(document.querySelectorAll('.filter-item'));
          const noresult = document.getElementById('noresult');
          const apply = () => {
            const q = (filterInput.value || '').trim().toLowerCase();
            let shown = 0;
            items.forEach((el) => {
              const ok = !q || (el.dataset.search || '').includes(q);
              el.style.display = ok ? '' : 'none';
              if (ok) shown++;
            });
            if (noresult) noresult.style.display = shown ? 'none' : 'block';
          };
          filterInput.addEventListener('input', apply);
          const clearBtn = document.getElementById('filter-clear');
          if (clearBtn) clearBtn.addEventListener('click', () => { filterInput.value = ''; apply(); filterInput.focus(); });
          const q = new URLSearchParams(location.search).get('q');
          if (q) filterInput.value = q;
          apply();
        }
        // Recherche globale (overlay)
        const overlay = document.getElementById('search-overlay');
        if (overlay) {
          const sInput = document.getElementById('site-search');
          const sResults = document.getElementById('search-results');
          const renderSearch = () => {
            const q = (sInput.value || '').trim().toLowerCase();
            if (!q) { sResults.innerHTML = '<p class="sr-hint">Tape un mot-clé pour chercher dans tous les articles.</p>'; return; }
            const list = (window.__searchIndex || []).filter((a) => (a.title + ' ' + a.excerpt + ' ' + a.category).toLowerCase().includes(q)).slice(0, 25);
            if (!list.length) { sResults.innerHTML = '<p class="sr-hint">Aucun article ne correspond.</p>'; return; }
            sResults.innerHTML = list.map((a) => '<a class="sr-item" href="' + a.url + '"><span class="sr-cat">' + a.category + '</span><span class="sr-title">' + a.title + '</span></a>').join('');
          };
          const openSearch = async () => {
            overlay.hidden = false; document.body.classList.add('no-scroll'); sInput.focus();
            if (!window.__searchIndex) { try { window.__searchIndex = await (await fetch('/search-index.json')).json(); } catch (e) { window.__searchIndex = []; } }
            renderSearch();
          };
          const closeSearch = () => { overlay.hidden = true; document.body.classList.remove('no-scroll'); sInput.value = ''; renderSearch(); };
          sInput.oninput = renderSearch;
          document.getElementById('search-close').onclick = closeSearch;
          document.getElementById('search-backdrop').onclick = closeSearch;
          document.onkeydown = (e) => { if (e.key === 'Escape' && !overlay.hidden) closeSearch(); };
          document.querySelectorAll('[data-search-open]').forEach((b) => { b.onclick = (e) => { e.preventDefault(); openSearch(); }; });
        }
        // YouTube : liens/iframes du contenu -> aperçu cliquable, puis clic -> lecteur
        const ytId = (url) => { if (!url) return ''; const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/))([\w-]{11})/); return m ? m[1] : (/^[\w-]{11}$/.test(url) ? url : ''); };
        document.querySelectorAll('.prose a[href*="youtu"], .prose iframe[src*="youtu"]').forEach((el) => {
          const url = el.getAttribute('href') || el.getAttribute('src') || '';
          const id = ytId(url);
          if (!id) return;
          if (el.tagName === 'A') {
            const txt = (el.textContent || '').trim().toLowerCase();
            if (txt && txt.indexOf('youtu') === -1 && txt !== url.toLowerCase()) return;
          }
          const fac = document.createElement('div');
          fac.className = 'yt-facade'; fac.dataset.id = id;
          fac.innerHTML = '<img loading="lazy" src="https://i.ytimg.com/vi/' + id + '/hqdefault.jpg" alt="Vidéo YouTube"><button class="yt-play" aria-label="Lire la vidéo"></button>';
          el.replaceWith(fac);
        });
        document.querySelectorAll('.yt-facade').forEach((f) => {
          if (f.dataset.bound) return; f.dataset.bound = '1';
          f.addEventListener('click', () => {
            const w = document.createElement('div'); w.className = 'video-embed';
            w.innerHTML = '<iframe src="https://www.youtube.com/embed/' + f.dataset.id + '?autoplay=1" title="Vidéo YouTube" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
            f.replaceWith(w);
          });
        });
        // Popup newsletter (après un délai, refermable, une fois par semaine)
        const pop = document.getElementById('nl-popup');
        if (pop) {
          const closePop = () => { pop.hidden = true; try { localStorage.setItem('nl_pop', String(Date.now())); } catch (e) {} };
          const px = document.getElementById('nl-popup-x'); if (px) px.onclick = closePop;
          const pb = document.getElementById('nl-popup-close'); if (pb) pb.onclick = closePop;
          let dismissed = false;
          try { const d = localStorage.getItem('nl_pop'); dismissed = !!d && (Date.now() - Number(d) < 7 * 24 * 3600 * 1000); } catch (e) {}
          if (!dismissed && !window.__nlPopScheduled) {
            window.__nlPopScheduled = true;
            setTimeout(() => { if (!pop.dataset.done) pop.hidden = false; }, 25000);
          }
        }
      }
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
