---
// Layout DÉDIÉ à l'Academy (plateforme d'apprentissage) — forme « site de tutoriels ».
// Aucune reprise du chrome blog (pas de bandeau actu, pas de sidebar articles, pas de popup newsletter).
// Même <head> que le site (SEO, police Poppins, GA4, mode sombre, ClientRouter).
import { SITE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean; // true = contenu pleine largeur (bibliothèque) ; false = gabarit lecteur géré par la page
}
const { title, description = 'Apprends pas à pas avec les experts Tutoria. Des parcours structurés, pratiques et téléchargeables.', image, wide = true } = Astro.props;
const pageTitle = title ? `${title} · Tutoria Academy` : `Tutoria Academy · Apprendre pas à pas`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tutoria Academy" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C4VSWCY4HC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag; gtag('js', new Date());
      gtag('config', 'G-C4VSWCY4HC', { send_page_view: false });
    </script>
  </head>
  <body class="ac-body">
    <header class="ac-top">
      <div class="ac-top-in">
        <button class="ac-burger" id="ac-burger" aria-label="Ouvrir le sommaire">☰</button>
        <a class="ac-brand" href="/academy/">
          <img src="/logo.png" alt="Tutoria" />
          <span class="ac-badge">Academy</span>
        </a>
        <form class="ac-search" action="/academy/" role="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="ac-q" name="q" placeholder="Rechercher un cours, une leçon…" autocomplete="off" aria-label="Rechercher" />
        </form>
        <nav class="ac-switch" aria-label="Basculer d'univers">
          <a href="/" class="ac-sw">Média</a>
          <span class="ac-sw active">Academy</span>
        </nav>
        <button class="ac-theme" id="theme-toggle" aria-label="Mode sombre">🌙</button>
      </div>
    </header>

    <main class={wide ? 'ac-main wide' : 'ac-main'}>
      <slot />
    </main>

    <footer class="ac-foot">
      <div class="ac-foot-in">
        <span><strong>Tutoria</strong> Academy · Explorez, Apprenez, Partagez</span>
        <span class="ac-foot-links"><a href="/academy/">Cours</a><a href="/">Média</a><a href="/contact/">Contact</a></span>
      </div>
    </footer>

    <Analytics />
    <script>
      function acSetup() {
        const root = document.documentElement;
        if (window.gtag) window.gtag('event', 'page_view', { page_path: location.pathname + location.search, page_location: location.href, page_title: document.title });
        const tt = document.getElementById('theme-toggle');
        if (tt && !tt.dataset.bound) { tt.dataset.bound = '1'; tt.addEventListener('click', () => { const n = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; root.setAttribute('data-theme', n); try { localStorage.setItem('theme', n); } catch (e) {} }); }
        // Ouverture/fermeture du sommaire (arbre) sur mobile — la page lecteur ajoute #ac-tree
        const burger = document.getElementById('ac-burger');
        if (burger && !burger.dataset.bound) { burger.dataset.bound = '1'; burger.addEventListener('click', () => { const tree = document.getElementById('ac-tree'); if (tree) tree.classList.toggle('mobile-open'); }); }
        // Arbre : déplier/replier un cours au clic sur la flèche
        document.querySelectorAll('.ac-caret-btn').forEach((b) => {
          if (b.dataset.bound) return; b.dataset.bound = '1';
          b.addEventListener('click', (e) => {
            e.preventDefault();
            const item = b.closest('.ac-tree-item');
            if (!item) return;
            const open = item.classList.toggle('open');
            b.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        });
        // Filtre bibliothèque (recherche client, page /academy)
        const q = document.getElementById('ac-q');
        const grid = document.getElementById('ac-lib');
        if (q && grid) {
          const cards = Array.from(grid.querySelectorAll('[data-search]'));
          const blocks = Array.from(grid.querySelectorAll('[data-pillar-block]'));
          const apply = () => {
            const v = (q.value || '').trim().toLowerCase();
            cards.forEach((c) => { c.style.display = !v || (c.dataset.search || '').includes(v) ? '' : 'none'; });
            blocks.forEach((b) => { const any = Array.from(b.querySelectorAll('[data-search]')).some((c) => c.style.display !== 'none'); b.style.display = any ? '' : 'none'; });
          };
          q.addEventListener('input', apply);
          const pre = new URLSearchParams(location.search).get('q'); if (pre) { q.value = pre; apply(); }
        }
      }
      document.addEventListener('astro:page-load', acSetup);
    </script>
  </body>
</html>

<style is:global>
  .ac-body { background: var(--bg); color: var(--ink); }
  .ac-top { position: sticky; top: 0; z-index: 50; background: var(--card); border-bottom: 1px solid var(--line); }
  .ac-top-in { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; gap: 16px; padding: 10px 20px; }
  .ac-burger { display: none; background: none; border: 0; font-size: 22px; color: var(--ink); cursor: pointer; }
  .ac-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; flex: 0 0 auto; }
  .ac-brand img { height: 30px; width: auto; display: block; }
  .ac-badge { background: var(--teal); color: #fff; font-weight: 800; font-size: .68rem; letter-spacing: .5px; padding: 2px 8px; border-radius: 999px; text-transform: uppercase; }
  .ac-search { flex: 1; max-width: 560px; display: flex; align-items: center; gap: 9px; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 9px 14px; color: var(--muted); }
  .ac-search input { flex: 1; border: 0; background: transparent; font-family: inherit; font-size: .95rem; color: var(--ink); outline: none; }
  .ac-switch { display: flex; align-items: center; gap: 4px; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 3px; flex: 0 0 auto; }
  .ac-sw { font-size: .84rem; font-weight: 700; padding: 6px 14px; border-radius: 999px; text-decoration: none; color: var(--muted); }
  .ac-sw.active { background: var(--teal); color: #fff; }
  .ac-theme { background: none; border: 0; font-size: 18px; cursor: pointer; flex: 0 0 auto; }
  .ac-main { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
  .ac-main.wide { padding-bottom: 60px; }
  .ac-foot { border-top: 1px solid var(--line); margin-top: 40px; background: var(--card); }
  .ac-foot-in { max-width: 1280px; margin: 0 auto; padding: 22px 20px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: .9rem; }
  .ac-foot-links a { color: var(--muted); text-decoration: none; margin-left: 16px; }
  .ac-foot-links a:hover { color: var(--teal); }
  @media (max-width: 860px) {
    .ac-burger { display: block; }
    .ac-switch, .ac-search { display: none; }
  }
</style>
