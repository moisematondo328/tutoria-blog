---
// Layout DÉDIÉ à Tutoria Academy — forme « plateforme d'apprentissage », identité distinctive.
// L'Academy est l'expérience principale ; le blog vit comme section « Articles ».
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getCollection } from 'astro:content';
import { PILLARS, SOCIALS, pillarByName } from '../consts';
import Ico from '../components/Ico.astro';
import '../styles/global.css';
import '../styles/academy.css';

// Cours groupés par domaine, pour le méga-menu "Domaines"
const allCourses = (await getCollection('courses', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const coursesByPillar = (slug: string) =>
  allCourses.filter((c) => pillarByName(c.data.category)?.slug === slug);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
}
const { title, description = 'La plateforme d’apprentissage de Tutoria : des parcours structurés, pratiques et téléchargeables, animés par des experts. Choisis ton domaine, suis le chemin, applique.', image, wide = true } = Astro.props;
const pageTitle = title ? `${title} · Tutoria Academy` : 'Tutoria Academy · Apprends, comprends, applique';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tutoria Academy" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C4VSWCY4HC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag; gtag('js', new Date());
      gtag('config', 'G-C4VSWCY4HC', { send_page_view: false });
    </script>
  </head>
  <body class="ac-body">
    <div class="ac-util">
      <div class="ac-util-in">
        <div class="ac-util-l">
          <a href="/academy/"><Ico class="ac-uic" name="ph:house-duotone" />Accueil</a>
          <a href="/academy/outils/tableau-blanc/"><Ico class="ac-uic" name="ph:chalkboard-simple-duotone" />Tableau blanc</a>
          <a href="/academy/outils/pratique/"><Ico class="ac-uic" name="ph:terminal-window-duotone" />Code de pratique</a>
          <a href="/academy/outils/calculatrice/"><Ico class="ac-uic" name="ph:chart-line-duotone" />Calculatrice graphique</a>
          <a href="/academy/outils/compilateur/"><Ico class="ac-uic" name="ph:code-duotone" />Compilateurs en ligne</a>
          <a href="/academy/articles/"><Ico class="ac-uic" name="ph:article-duotone" />Articles</a>
          <a href="/academy/outils/"><Ico class="ac-uic" name="ph:wrench-duotone" />Outils</a>
        </div>
        <div class="ac-util-r">
          <a class="ac-soc" href={SOCIALS.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Ico name="si:tiktok" /></a>
          <a class="ac-soc" href={SOCIALS.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Ico name="si:youtube" /></a>
          <a class="ac-soc" href={SOCIALS.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Ico name="si:facebook" /></a>
          <button class="ac-theme" id="theme-toggle" aria-label="Mode sombre">🌙</button>
        </div>
      </div>
    </div>
    <header class="ac-top">
      <div class="ac-top-in">
        <button class="ac-burger" id="ac-burger" aria-label="Ouvrir le menu">☰</button>
        <a class="ac-brand" href="/academy/">
          <img src="/logo.png" alt="Tutoria" />
          <span class="ac-badge">Academy</span>
        </a>
        <nav class="ac-nav" aria-label="Navigation Academy">
          <div class="ac-drop">
            <button class="ac-drop-t" type="button">Domaines <span aria-hidden="true">▾</span></button>
            <div class="ac-mega">
              <div class="ac-mega-cols">
                {PILLARS.map((p) => {
                  const cs = coursesByPillar(p.slug);
                  return (
                    <div class="ac-mega-col" style={`--c:${p.color}`}>
                      <a class="ac-mega-h" href={`/academy/#${p.slug}`}><span class="d-dot" style={`background:${p.color}`}></span>{p.name}</a>
                      <p class="ac-mega-blurb">{p.blurb}</p>
                      <ul class="ac-mega-list">
                        {cs.length === 0
                          ? <li class="ac-mega-soon">Parcours à venir</li>
                          : cs.slice(0, 4).map((c) => <li><a href={`/academy/${c.id}/`}>{c.data.title}</a></li>)}
                      </ul>
                    </div>
                  );
                })}
              </div>
              <div class="ac-mega-foot">
                <a href="/academy/bibliotheque/">Bibliothèque complète</a>
                <a href="/academy/">Tous les cours</a>
                <a href="/academy/outils/">Outils</a>
                <a href="/academy/accompagnement/">Accompagnement</a>
                <a href="/academy/articles/">Articles</a>
              </div>
            </div>
          </div>
          <a href="/academy/bibliotheque/" class={path.startsWith('/academy/bibliotheque') ? 'cur' : ''}>Bibliothèque</a>
          <a href="/academy/articles/" class={path.startsWith('/academy/articles') ? 'cur' : ''}>Articles</a>
          <a href="/academy/accompagnement/" class={path.startsWith('/academy/accompagnement') ? 'cur ac-nav-pro' : 'ac-nav-pro'}>Accompagnement</a>
        </nav>
        <form class="ac-search" action="/academy/recherche/" role="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="ac-q" name="q" placeholder="Rechercher un cours…" autocomplete="off" aria-label="Rechercher" />
        </form>
        <a class="ac-acct" id="ac-acct" href="/academy/compte/connexion/">Se connecter</a>
        <a class="ac-btn ac-btn-primary" href="/academy/#catalogue" style="padding:9px 18px">Commencer</a>
      </div>
      <nav class="ac-mobile" id="ac-mobile" aria-label="Menu mobile">
        <div class="ac-mob-pillars">
          {PILLARS.map((p) => (
            <a href={`/academy/#${p.slug}`}><span class="ac-mob-dot" style={`background:${p.color}`}></span>{p.name}</a>
          ))}
        </div>
        <a href="/academy/">Tous les cours</a>
        <a href="/academy/bibliotheque/">Bibliothèque</a>
        <a href="/academy/articles/">Articles</a>
        <a class="pro" href="/academy/accompagnement/">Accompagnement</a>
        <a href="/academy/outils/">Outils</a>
        <a href="/academy/recherche/">Rechercher</a>
        <a href="/academy/compte/">Mon compte</a>
        <a class="ac-mob-cta" href="/academy/#catalogue">Commencer</a>
      </nav>
    </header>

    <main class={wide ? 'ac-main' : 'ac-main'}>
      <slot />
    </main>

    <footer class="ac-foot">
      <div class="ac-foot-cols">
        <div class="ac-foot-brand">
          <span class="ac-foot-logo"><b>Tutoria</b> <span class="tag">Academy</span></span>
          <p>La plateforme d'apprentissage francophone. Choisis ton domaine, suis le chemin, applique.</p>
        </div>
        <div>
          <h4>Domaines</h4>
          {PILLARS.map((p) => <a href={`/academy/#${p.slug}`}>{p.name}</a>)}
        </div>
        <div>
          <h4>Academy</h4>
          <a href="/academy/">Tous les cours</a>
          <a href="/academy/accompagnement/">Accompagnement</a>
          <a href="/academy/articles/">Articles</a>
          <a href="/academy/outils/">Outils</a>
          <a href="/academy/a-propos/">À propos</a>
        </div>
        <div>
          <h4>Suivre</h4>
          <a href={SOCIALS.tiktok} target="_blank" rel="noopener">TikTok</a>
          <a href={SOCIALS.youtube} target="_blank" rel="noopener">YouTube</a>
          <a href={SOCIALS.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href="/academy/contact/">Contact</a>
        </div>
      </div>
      <div class="ac-foot-bottom"><div class="ac-foot-bottom-in"><span>© 2026 Tutoria Academy</span><span>Explorez, Apprenez, Partagez</span></div></div>
    </footer>

    <Analytics />
    <SpeedInsights />
    <script>
      function acSetup() {
        const root = document.documentElement;
        if (window.gtag) window.gtag('event', 'page_view', { page_path: location.pathname + location.search, page_location: location.href, page_title: document.title });
        const tt = document.getElementById('theme-toggle');
        if (tt && !tt.dataset.bound) { tt.dataset.bound = '1'; tt.addEventListener('click', () => { const n = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; root.setAttribute('data-theme', n); try { localStorage.setItem('theme', n); } catch (e) {} }); }
        const burger = document.getElementById('ac-burger');
        if (burger && !burger.dataset.bound) {
          burger.dataset.bound = '1';
          burger.addEventListener('click', () => {
            const menu = document.getElementById('ac-mobile');
            if (menu) { const open = menu.classList.toggle('open'); burger.setAttribute('aria-expanded', open ? 'true' : 'false'); }
          });
        }
        const acct = document.getElementById('ac-acct');
        if (acct && !acct.dataset.bound) {
          acct.dataset.bound = '1';
          fetch('/api/auth/me').then((r) => r.json()).then((d) => {
            if (!d || !d.user) return;
            const u = d.user;
            acct.href = '/academy/compte/';
            const first = (u.name || u.email).split(/\s+/)[0];
            const parts = (u.name || u.email).trim().split(/\s+/);
            const ini = ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase() || (u.email[0] || '?').toUpperCase();
            const av = u.avatar ? `<span class="ac-avatar"><img src="${u.avatar}" alt=""></span>` : `<span class="ac-avatar">${ini}</span>`;
            acct.innerHTML = `${av}<span>${first}</span>`;
          }).catch(() => {});
        }
        document.querySelectorAll('.ac-caret-btn').forEach((b) => {
          if (b.dataset.bound) return; b.dataset.bound = '1';
          b.addEventListener('click', (e) => { e.preventDefault(); const item = b.closest('.ac-tree-item'); if (!item) return; const open = item.classList.toggle('open'); b.setAttribute('aria-expanded', open ? 'true' : 'false'); });
        });
        document.querySelectorAll('.ac-quiz-q').forEach((qq) => {
          if (qq.dataset.bound) return; qq.dataset.bound = '1';
          const opts = Array.from(qq.querySelectorAll('.ac-quiz-opt'));
          opts.forEach((o) => o.addEventListener('click', () => {
            if (qq.dataset.done) return; qq.dataset.done = '1';
            opts.forEach((x) => { x.disabled = true; if (x.dataset.correct === '1') x.classList.add('ok'); });
            if (o.dataset.correct !== '1') o.classList.add('ko');
          }));
        });
        const q = document.getElementById('ac-q');
        const grid = document.getElementById('ac-lib');
        if (q && grid) {
          const cards = Array.from(grid.querySelectorAll('[data-search]'));
          const blocks = Array.from(grid.querySelectorAll('[data-pillar-block]'));
          const apply = () => {
            const v = (q.value || '').trim().toLowerCase();
            cards.forEach((c) => { c.style.display = !v || (c.dataset.search || '').includes(v) ? '' : 'none'; });
            blocks.forEach((b) => { const any = Array.from(b.querySelectorAll('[data-search]')).some((c) => c.style.display !== 'none'); b.style.display = any ? '' : 'none'; });
          };
          q.addEventListener('input', apply);
          const pre = new URLSearchParams(location.search).get('q'); if (pre) { q.value = pre; apply(); }
        }
      }
      document.addEventListener('astro:page-load', acSetup);
    </script>
  </body>
</html>
