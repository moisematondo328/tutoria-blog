---
// Jeu d'icônes maison — trait cohérent (line, arrondi), couleur = currentColor.
interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  // Piliers
  health: '<path d="M3.5 12h3l2-5 3 9 2.5-7 1.5 3h5"/>',
  growth: '<polyline points="3 17 9 11 13 15 21 6"/><polyline points="15 6 21 6 21 12"/>',
  finance: '<ellipse cx="9" cy="7" rx="5.5" ry="2.6"/><path d="M3.5 7v4c0 1.4 2.5 2.6 5.5 2.6s5.5-1.2 5.5-2.6V7"/><path d="M9 13.6v3.8c0 1.4 2.5 2.6 5.5 2.6s5.5-1.2 5.5-2.6v-6"/><ellipse cx="14.5" cy="11.4" rx="5.5" ry="2.6"/>',
  tech: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><rect x="10" y="10" width="4" height="4" rx="0.5"/><path d="M10 3v3M14 3v3M10 18v3M14 18v3M3 10h3M3 14h3M18 10h3M18 14h3"/>',
  // Meta / UI
  author: '<circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  chat: '<path d="M20 4H4a1.5 1.5 0 0 0-1.5 1.5V15A1.5 1.5 0 0 0 4 16.5h3V21l4.5-4.5H20A1.5 1.5 0 0 0 21.5 15V5.5A1.5 1.5 0 0 0 20 4Z"/>',
  bolt: '<path d="M13 2 4.5 13.5H11l-1 8.5L19 10.5h-6.5L13 2Z"/>',
  bell: '<path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M13.7 20a2 2 0 0 1-3.4 0"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  chevronL: '<path d="M15 6l-6 6 6 6"/>',
  chevronR: '<path d="M9 6l6 6-6 6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  book: '<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H18a1 1 0 0 1 1 1v14.5H6.5A1.5 1.5 0 0 0 5 20V4.5Z"/><path d="M19 18.5H6.5A1.5 1.5 0 0 0 5 20"/>',
  download: '<path d="M12 3v11M7.5 10 12 14.5 16.5 10"/><path d="M5 20h14"/>',
};
const inner = paths[name] ?? '';
const isFilled = name === 'bolt';
---
<svg
  width={size} height={size} viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
  class={`icon ${cls}`} aria-hidden="true" set:html={inner}
/>
