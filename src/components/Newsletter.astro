---
// Newsletter reliée à Web3Forms — les inscriptions arrivent par email.
import Icon from './Icon.astro';
---
<div class="newsletter">
  <div class="bell"><Icon name="bell" size={40} /></div>
  <h4>Oh bonjour 👋</h4>
  <p>Inscris-toi à notre newsletter pour suivre nos actualités.</p>
  <form class="w3form" action="https://api.web3forms.com/submit" method="POST"
    data-success="✅ Inscription confirmée — à très vite !">
    <input type="hidden" name="access_key" value="bdb279ee-0299-4b3a-985a-e8ee91257ba0" />
    <input type="hidden" name="subject" value="Nouvel abonné newsletter — Tutoria News" />
    <input type="hidden" name="from_name" value="Newsletter Tutoria News" />
    <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
    <input type="email" name="email" placeholder="Adresse e-mail *" required aria-label="Adresse e-mail" />
    <button type="submit">S'abonner</button>
    <small class="form-msg">Nous ne spammons pas ! Consulte notre politique de confidentialité.</small>
  </form>
</div>
