---
// Newsletter reliée à Brevo via la fonction serveur /api/subscribe.
// Le design (carte teal) reste 100 % Tutoria ; l'abonné arrive dans la liste Brevo.
import Icon from './Icon.astro';
---
<div class="newsletter">
  <div class="bell"><Icon name="bell" size={40} /></div>
  <h4>Oh bonjour 👋</h4>
  <p>Reçois nos meilleurs conseils directement dans ta boîte mail.</p>
  <form class="nl-form" action="/api/subscribe" method="POST"
    data-success="✅ C'est fait, à très vite dans ta boîte mail !">
    <input type="email" name="email" placeholder="Ton adresse e-mail" required aria-label="Adresse e-mail" />
    <button type="submit">S'abonner</button>
    <small class="nl-note">Pas de spam. Tu peux te désinscrire quand tu veux. Vois notre <a href="/confidentialite/">politique de confidentialité</a>.</small>
    <small class="form-msg"></small>
  </form>
</div>
