---
import { getCollection } from 'astro:content';
import { PILLARS, catSlugOf } from '../consts';
import Newsletter from './Newsletter.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const recent = posts.slice(0, 5);
const counts = Object.fromEntries(
  PILLARS.map((p) => [p.slug, posts.filter((x) => catSlugOf(x.data) === p.slug).length])
);
---

<aside class="sidebar">
  <div class="widget">
    <h4>Rechercher</h4>
    <button class="search-trigger" data-search-open type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Rechercher un article…</span>
    </button>
  </div>

  <div class="widget">
    <h4>Articles récents</h4>
    <ul class="recent">
      {recent.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
    </ul>
  </div>

  <div class="widget">
    <h4>Catégories</h4>
    <ul class="cats">
      {PILLARS.map((p) => (
        <li><a href={`/categorie/${p.slug}/`}>{p.name}<span>{counts[p.slug]}</span></a></li>
      ))}
    </ul>
  </div>

  <Newsletter />
</aside>
