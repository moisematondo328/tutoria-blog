---
// Tableau de bord privé Tutoria News (non listé, non indexé).
// Tout-en-un : Diffusion (manuelle + automatique) + Modération.
// Protégé par le SECRET (variable ADMIN_SECRET) saisi ici.
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Tableau de bord — Tutoria News</title>
  <style is:global>
    :root { --teal:#0E8074; --teal-d:#0b6e64; --teal-l:#12a594; --yellow:#FDD200; --yellow-d:#e9be00;
            --ink:#23302e; --muted:#6b7a78; --line:#e6ece9; --bg:#eef3f1; --card:#ffffff;
            --shadow:0 6px 22px rgba(12,40,37,.07); --radius:16px;
            --font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
    * { box-sizing:border-box; }
    body { font-family:var(--font); margin:0; background:var(--bg); color:var(--ink); }
    .wrap { max-width:920px; margin:0 auto; padding:24px 18px 70px; }
    a { color:var(--teal); }
    button { font-family:var(--font); border:0; border-radius:10px; font-weight:700; cursor:pointer; font-size:14px; }
    button:disabled { opacity:.55; cursor:default; }

    /* Connexion */
    .login { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px; }
    .login-card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:34px 30px; width:min(380px,100%); text-align:center; }
    .brand { font-size:26px; font-weight:800; color:var(--teal); }
    .brand span { color:var(--yellow); }
    .login-card p { color:var(--muted); font-size:14px; margin:6px 0 22px; }
    .field { width:100%; padding:12px 14px; border:1px solid #cfe0dc; border-radius:11px; font-size:15px; margin-bottom:12px; }
    .field:focus { outline:2px solid var(--teal); border-color:var(--teal); }
    .btn-primary { background:var(--teal); color:#fff; padding:12px 18px; width:100%; }
    .btn-primary:hover { background:var(--teal-d); }
    .err { color:#c0392b; font-size:13px; font-weight:600; min-height:1em; margin-top:8px; }

    /* Topbar */
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:22px; }
    .topbar .brand { font-size:22px; }
    .topbar .right { display:flex; align-items:center; gap:16px; }
    .logout { background:none; color:var(--muted); font-size:13px; }
    .logout:hover { color:var(--ink); }

    /* KPIs */
    .kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:24px; }
    .kpi { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:18px 20px; }
    .kpi .n { font-size:30px; font-weight:800; color:var(--teal); line-height:1; }
    .kpi .l { font-size:12.5px; color:var(--muted); margin-top:7px; text-transform:uppercase; letter-spacing:.06em; }
    @media(max-width:560px){ .kpis{ grid-template-columns:repeat(3,1fr); gap:8px; } .kpi{ padding:14px 12px; } .kpi .n{ font-size:22px; } .kpi .l{ font-size:10.5px; } }

    /* Tabs */
    .tabs { display:flex; gap:6px; margin-bottom:18px; }
    .tab { background:none; color:var(--muted); padding:11px 18px; border-radius:11px; }
    .tab.active { background:var(--teal); color:#fff; }
    .pending-dot { display:inline-block; min-width:18px; padding:0 5px; height:18px; line-height:18px; border-radius:999px; background:var(--yellow); color:var(--teal-d); font-size:11px; font-weight:800; margin-left:7px; }
    .panel { display:none; } .panel.active { display:block; }

    /* Cartes */
    .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:16px 18px; margin-bottom:13px; }
    .row { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
    .title { font-weight:700; font-size:15.5px; }
    .meta { font-size:12.5px; color:var(--muted); margin-top:4px; }
    .badge { font-size:11px; font-weight:800; padding:3px 9px; border-radius:999px; }
    .badge.sent { background:#eaf7ec; color:#2e7d32; }
    .send { background:var(--yellow); color:var(--teal-d); padding:10px 16px; white-space:nowrap; }
    .send:hover { background:var(--yellow-d); }
    .send.again { background:#eef4f2; color:var(--teal-d); }
    .txt { white-space:pre-wrap; line-height:1.55; margin-top:2px; }
    .cactions { margin-top:12px; display:flex; gap:9px; }
    .approve { background:var(--teal); color:#fff; padding:9px 15px; } .approve:hover{ background:var(--teal-d); }
    .delete { background:#fdecec; color:#c0392b; padding:9px 15px; } .delete:hover{ background:#f9d9d9; }
    .msg { font-weight:600; color:var(--teal-d); margin:2px 0 14px; min-height:1.1em; font-size:14px; }
    .empty { color:var(--muted); background:var(--card); border:1px dashed var(--line); border-radius:var(--radius); padding:26px; text-align:center; }

    /* Liste d'articles (Diffusion) */
    .art { display:flex; align-items:center; gap:16px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:12px 14px; margin-bottom:11px; transition:border-color .15s, transform .15s; }
    .art:hover { border-color:#cfe0dc; transform:translateY(-1px); }
    .art-thumb { flex:0 0 auto; width:78px; height:56px; border-radius:11px; background:#dfeae7 center/cover no-repeat; }
    .art-thumb.ph { display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,var(--teal),var(--teal-l)); color:#fff; font-weight:800; font-size:22px; }
    .art-main { flex:1 1 auto; min-width:0; }
    .art-title { font-weight:700; font-size:15px; line-height:1.3; }
    .art-meta { font-size:12.5px; color:var(--muted); margin-top:5px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .send { flex:0 0 auto; }
    .search { width:100%; padding:12px 15px; border:1px solid var(--line); border-radius:12px; font-size:14.5px; background:var(--card); margin-bottom:14px; }
    .search:focus { outline:2px solid var(--teal); border-color:var(--teal); }
    .more-btn { background:#eef4f2; color:var(--teal-d); padding:11px 22px; }
    .more-btn:hover { background:#e2eeea; }
    .diff-count { font-size:12.5px; color:var(--muted); margin-bottom:10px; }

    /* Créer (usine à articles) */
    .lbl { display:block; font-weight:700; font-size:13px; color:var(--ink); margin:14px 0 6px; }
    .lbl:first-child { margin-top:0; }
    .hint { font-weight:500; color:var(--muted); font-size:12px; }
    .fld { width:100%; padding:11px 13px; border:1px solid var(--line); border-radius:11px; font-size:14.5px; font-family:var(--font); background:var(--card); color:var(--ink); }
    .ta { width:100%; padding:12px 14px; border:1px solid var(--line); border-radius:12px; font-size:14.5px; font-family:var(--font); background:var(--card); color:var(--ink); resize:vertical; }
    .ta.mono { font-family:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace; font-size:13px; line-height:1.55; }
    .fld:focus, .ta:focus { outline:2px solid var(--teal); border-color:var(--teal); }
    .primary { background:var(--teal); color:#fff; padding:12px 20px; } .primary:hover { background:var(--teal-d); }
    .chk { display:flex; align-items:center; gap:9px; margin:16px 0 4px; font-size:14px; color:var(--muted); }
    .pub-row { display:flex; align-items:center; gap:14px; margin-top:16px; flex-wrap:wrap; }

    /* Cartes commentaires (Modération) */
    .cmt { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:16px 18px; margin-bottom:12px; }
    .cmt-top { display:flex; align-items:center; gap:12px; }
    .avatar { flex:0 0 auto; width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,var(--teal),var(--teal-l)); color:#fff; font-weight:800; font-size:17px; display:flex; align-items:center; justify-content:center; text-transform:uppercase; }
    .cmt-name { font-weight:700; font-size:15px; }
    .cmt-sub { font-size:12.5px; color:var(--muted); margin-top:2px; }
    .cmt-sub a { color:var(--teal); text-decoration:none; font-weight:600; }
    .cmt-sub a:hover { text-decoration:underline; }
    .cmt-text { margin:13px 0 4px; padding:10px 0 10px 15px; border-left:3px solid var(--yellow); color:var(--ink); line-height:1.55; white-space:pre-wrap; }

    /* Interrupteur auto */
    .auto { background:linear-gradient(180deg,#eff6f4,#ffffff); border:1px solid var(--line); }
    .auto .row { align-items:flex-start; }
    .auto h3 { margin:0 0 4px; font-size:15.5px; color:var(--ink); }
    .auto p { margin:0; font-size:13px; color:var(--muted); max-width:520px; line-height:1.5; }
    .switch { position:relative; width:52px; height:30px; flex:0 0 auto; }
    .switch input { display:none; }
    .slider { position:absolute; inset:0; background:#cdd9d5; border-radius:999px; transition:.2s; }
    .slider::before { content:""; position:absolute; width:24px; height:24px; left:3px; top:3px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.25); }
    .switch input:checked + .slider { background:var(--teal); }
    .switch input:checked + .slider::before { transform:translateX(22px); }
    .auto-state { font-size:12px; font-weight:800; margin-top:8px; }
    .auto-state.on { color:var(--teal-d); } .auto-state.off { color:var(--muted); }

    .links { margin-top:28px; padding-top:16px; border-top:1px solid var(--line); font-size:14px; }
    .links a { font-weight:600; text-decoration:none; margin-right:20px; }
  </style>
</head>
<body>
  <!-- Écran de connexion -->
  <div class="login" id="login">
    <div class="login-card">
      <div class="brand">Tutoria <span>News</span></div>
      <p>Tableau de bord privé</p>
      <input class="field" id="secret" type="password" placeholder="Mot de passe" autocomplete="current-password" />
      <button class="btn-primary" id="loginBtn">Se connecter</button>
      <div class="err" id="loginErr"></div>
    </div>
  </div>

  <!-- Tableau de bord -->
  <div class="wrap" id="app" style="display:none">
    <div class="topbar">
      <div class="brand">Tutoria <span>News</span></div>
      <div class="right">
        <span class="meta" style="margin:0">Tableau de bord</span>
        <button class="logout" id="logout">Déconnexion</button>
      </div>
    </div>

    <div class="kpis">
      <div class="kpi"><div class="n" id="kpi-subs">—</div><div class="l">Abonnés</div></div>
      <div class="kpi"><div class="n" id="kpi-pending">—</div><div class="l">À modérer</div></div>
      <div class="kpi"><div class="n" id="kpi-arts">—</div><div class="l">Articles</div></div>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="creer">Créer</button>
      <button class="tab" data-tab="diffusion">Diffusion</button>
      <button class="tab" data-tab="moderation">Modération <span class="pending-dot" id="tab-pending" style="display:none">0</span></button>
    </div>

    <!-- Créer (usine à articles) -->
    <section class="panel active" id="panel-creer">
      <div class="card">
        <label class="lbl">Sujet de l'article</label>
        <textarea id="gen-topic" class="ta" rows="2" placeholder="Ex : Comment se constituer un fonds d'urgence quand on a un petit salaire"></textarea>
        <button class="primary" id="gen-btn" style="margin-top:12px">Générer l'article avec l'IA</button>
        <div class="msg" id="gen-msg"></div>
      </div>
      <div id="draft-form" style="display:none">
        <div class="card">
          <label class="lbl">Titre</label>
          <input id="d-title" class="fld" type="text" />
          <label class="lbl">Rubrique</label>
          <select id="d-cat" class="fld">
            <option>Santé &amp; Bien-être</option>
            <option>Développement Personnel</option>
            <option>Finance &amp; Investissement</option>
            <option>Technologie Émergente</option>
          </select>
          <label class="lbl">Résumé (pour le SEO et les cartes)</label>
          <textarea id="d-excerpt" class="ta" rows="2"></textarea>
          <label class="lbl">Image à la une <span class="hint" id="d-imgq"></span></label>
          <input id="d-cover" class="fld" type="text" placeholder="/uploads/2026/…/image.webp ou une URL (optionnel)" />
          <label class="lbl">Contenu de l'article (Markdown)</label>
          <textarea id="d-body" class="ta mono" rows="16"></textarea>
          <label class="chk"><input type="checkbox" id="d-draft" /> Publier en brouillon (non visible sur le site)</label>
          <div class="pub-row">
            <button class="primary" id="pub-btn">Publier l'article</button>
            <span class="msg" id="pub-msg" style="margin:0"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Diffusion -->
    <section class="panel" id="panel-diffusion">
      <div class="card auto">
        <div class="row">
          <div>
            <h3>Diffusion automatique</h3>
            <p>Envoie chaque <b>nouvel</b> article aux abonnés dès sa publication. Tes anciens articles ne sont jamais renvoyés.</p>
            <div class="auto-state off" id="auto-state">Désactivée</div>
          </div>
          <label class="switch"><input type="checkbox" id="auto-toggle" /><span class="slider"></span></label>
        </div>
      </div>
      <input id="diff-search" class="search" type="search" placeholder="Rechercher un article par titre…" />
      <div class="msg" id="diff-msg"></div>
      <div id="diff-list"></div>
      <div style="text-align:center;margin-top:8px"><button id="diff-more" class="more-btn" style="display:none">Afficher plus</button></div>
    </section>

    <!-- Modération -->
    <section class="panel" id="panel-moderation">
      <div class="msg" id="mod-msg"></div>
      <div id="mod-list"></div>
    </section>

    <div class="links">
      <a href="https://app.pagescms.org/" target="_blank" rel="noopener">Écrire un article (Pages CMS)</a>
      <a href="/" target="_blank" rel="noopener">Voir le site</a>
    </div>
  </div>

  <script is:inline>
    const $ = (s) => document.querySelector(s);
    const secretEl = $('#secret');
    const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[m]));
    const fdate = (d) => new Date(d).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
    const secret = () => secretEl.value.trim();
    try { const s = localStorage.getItem('mod_secret'); if (s) secretEl.value = s; } catch (e) {}

    document.querySelectorAll('.tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
      document.querySelectorAll('.panel').forEach((x) => x.classList.remove('active'));
      t.classList.add('active');
      $('#panel-' + t.dataset.tab).classList.add('active');
    }));

    async function connect() {
      if (!secret()) return;
      const r = await fetch('/api/broadcast?secret=' + encodeURIComponent(secret()));
      if (r.status === 401) { $('#loginErr').textContent = 'Mot de passe incorrect.'; return; }
      try { localStorage.setItem('mod_secret', secret()); } catch (e) {}
      $('#login').style.display = 'none';
      $('#app').style.display = 'block';
      const d = await r.json();
      renderDiffusion(d);
      loadModeration();
    }

    let ALL = [];
    let shown = 12;
    const STEP = 12;

    function renderDiffusion(d) {
      ALL = (d && d.articles) || [];
      $('#kpi-subs').textContent = (d && typeof d.subscribers === 'number') ? d.subscribers : '—';
      $('#kpi-arts').textContent = ALL.length;
      const t = $('#auto-toggle'); t.checked = !!(d && d.auto);
      setAutoLabel(t.checked);
      renderList();
    }

    function renderList() {
      const q = ($('#diff-search').value || '').toLowerCase().trim();
      const filtered = q ? ALL.filter((a) => a.title.toLowerCase().includes(q)) : ALL;
      const view = q ? filtered : filtered.slice(0, shown);
      const rows = view.map((a) => {
        const thumb = a.cover
          ? `<div class="art-thumb" style="background-image:url('${esc(a.cover)}')"></div>`
          : `<div class="art-thumb ph">${esc((a.title || 'T').trim().charAt(0))}</div>`;
        return `
        <div class="art">
          ${thumb}
          <div class="art-main">
            <div class="art-title">${esc(a.title)}</div>
            <div class="art-meta">${fdate(a.date)}${a.sent ? ' <span class="badge sent">déjà diffusé</span>' : ''}</div>
          </div>
          <button class="send ${a.sent ? 'again' : ''}" data-slug="${esc(a.slug)}">${a.sent ? 'Renvoyer' : 'Envoyer aux abonnés'}</button>
        </div>`;
      }).join('');
      const count = q
        ? `<div class="diff-count">${filtered.length} résultat(s) pour « ${esc(q)} »</div>`
        : `<div class="diff-count">${ALL.length} article(s) · ${view.length} affiché(s)</div>`;
      $('#diff-list').innerHTML = rows ? count + rows : '<p class="empty">Aucun article ne correspond à ta recherche.</p>';
      $('#diff-more').style.display = (!q && filtered.length > shown) ? 'inline-block' : 'none';
    }
    $('#diff-search').addEventListener('input', () => { shown = STEP; renderList(); });
    $('#diff-more').addEventListener('click', () => { shown += STEP; renderList(); });
    function setAutoLabel(on) {
      const el = $('#auto-state');
      el.textContent = on ? 'Activée' : 'Désactivée';
      el.className = 'auto-state ' + (on ? 'on' : 'off');
    }

    $('#auto-toggle').addEventListener('change', async (e) => {
      const on = e.target.checked;
      setAutoLabel(on);
      const r = await fetch('/api/broadcast', { method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ secret: secret(), action:'setAuto', value: on }) });
      if (!r.ok) { e.target.checked = !on; setAutoLabel(!on); $('#diff-msg').textContent = 'Impossible de changer le réglage.'; }
      else { $('#diff-msg').textContent = on ? 'Diffusion automatique activée. Seuls les prochains articles seront envoyés.' : 'Diffusion automatique désactivée.'; }
    });

    $('#diff-list').addEventListener('click', async (e) => {
      const btn = e.target.closest('button.send'); if (!btn) return;
      if (!confirm('Envoyer cet article à TOUS tes abonnés ?')) return;
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Envoi…'; $('#diff-msg').textContent = '';
      const r = await fetch('/api/broadcast', { method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ secret: secret(), slug: btn.dataset.slug }) });
      const d = await r.json().catch(() => ({}));
      if (d.ok) { $('#diff-msg').textContent = 'Article envoyé aux abonnés.'; refreshDiffusion(); }
      else { btn.disabled = false; btn.textContent = orig; $('#diff-msg').textContent = 'Échec : ' + (d.error || 'réessaie') + '.'; }
    });
    async function refreshDiffusion() {
      const r = await fetch('/api/broadcast?secret=' + encodeURIComponent(secret()));
      renderDiffusion(await r.json());
    }

    async function loadModeration() {
      const r = await fetch('/api/moderate?secret=' + encodeURIComponent(secret()));
      const d = await r.json();
      const pend = (d && d.pending) || [];
      $('#kpi-pending').textContent = pend.length;
      const dot = $('#tab-pending'); dot.textContent = pend.length; dot.style.display = pend.length ? 'inline-block' : 'none';
      $('#mod-msg').textContent = pend.length ? '' : '';
      $('#mod-list').innerHTML = pend.map((c) => `
        <div class="cmt" data-page="${encodeURIComponent(c.pageId)}" data-id="${c.id}">
          <div class="cmt-top">
            <div class="avatar">${esc((c.name || '?').trim().charAt(0))}</div>
            <div>
              <div class="cmt-name">${esc(c.name)}</div>
              <div class="cmt-sub">${new Date(c.date).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' })} &middot; sur <a href="${esc(c.pageId)}" target="_blank" rel="noopener">${esc(articleLabel(c.pageId))}</a></div>
            </div>
          </div>
          <div class="cmt-text">${esc(c.text)}</div>
          <div class="cactions">
            <button class="approve" data-a="approve">Approuver</button>
            <button class="delete" data-a="delete">Supprimer</button>
          </div>
        </div>`).join('') || '<p class="empty">Aucun commentaire en attente. Tout est à jour.</p>';
    }
    function articleLabel(pageId) {
      const seg = String(pageId).replace(/\/+$/, '').split('/').pop() || 'article';
      const s = seg.replace(/-/g, ' ').trim();
      return s.charAt(0).toUpperCase() + s.slice(1);
    }
    $('#mod-list').addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-a]'); if (!btn) return;
      const card = btn.closest('.cmt'); btn.disabled = true;
      const r = await fetch('/api/moderate', { method:'POST', headers:{'content-type':'application/json'},
        body: JSON.stringify({ secret: secret(), action: btn.dataset.a, pageId: decodeURIComponent(card.dataset.page), id: card.dataset.id }) });
      if (r.ok) { card.remove(); loadModeration(); } else { btn.disabled = false; }
    });

    // --- Créer (usine à articles) ---
    $('#gen-btn').addEventListener('click', async () => {
      const topic = $('#gen-topic').value.trim();
      if (topic.length < 4) { $('#gen-msg').textContent = 'Donne un sujet un peu plus précis.'; return; }
      const btn = $('#gen-btn'); btn.disabled = true; const o = btn.textContent; btn.textContent = 'Rédaction en cours…';
      $('#gen-msg').textContent = 'L’IA rédige ton article, patiente quelques secondes…';
      try {
        const r = await fetch('/api/generate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ secret: secret(), topic }) });
        const d = await r.json().catch(() => ({}));
        if (d.ok && d.article) {
          const a = d.article;
          $('#d-title').value = a.title || '';
          $('#d-cat').value = a.category || 'Développement Personnel';
          $('#d-excerpt').value = a.excerpt || '';
          $('#d-body').value = a.body || '';
          $('#d-imgq').textContent = a.imageQuery ? ('· idée d’image : ' + a.imageQuery) : '';
          $('#draft-form').style.display = 'block';
          $('#gen-msg').textContent = 'Brouillon prêt. Relis, ajuste, puis publie.';
        } else if (d.error === 'config') { $('#gen-msg').textContent = 'La clé Gemini n’est pas encore configurée sur le site.'; }
        else { $('#gen-msg').textContent = 'La génération a échoué : ' + (d.error || 'réessaie') + '.'; }
      } catch (e) { $('#gen-msg').textContent = 'Connexion perdue, réessaie.'; }
      btn.disabled = false; btn.textContent = o;
    });

    $('#pub-btn').addEventListener('click', async () => {
      const payload = { secret: secret(), title: $('#d-title').value.trim(), category: $('#d-cat').value, excerpt: $('#d-excerpt').value.trim(), cover: $('#d-cover').value.trim(), body: $('#d-body').value.trim(), draft: $('#d-draft').checked };
      if (payload.title.length < 4 || payload.body.length < 40) { $('#pub-msg').textContent = 'Titre et contenu requis.'; return; }
      const btn = $('#pub-btn'); btn.disabled = true; const o = btn.textContent; btn.textContent = 'Publication…';
      try {
        const r = await fetch('/api/publish', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const d = await r.json().catch(() => ({}));
        if (d.ok) {
          $('#pub-msg').innerHTML = d.draft
            ? 'Enregistré en brouillon. Le site se met à jour (1 à 2 min).'
            : 'Publié. En ligne dans 1 à 2 min : <a href="' + d.url + '" target="_blank" rel="noopener">voir l’article</a>';
        } else if (d.error === 'config') { $('#pub-msg').textContent = 'L’accès GitHub n’est pas configuré sur le site.'; }
        else { $('#pub-msg').textContent = 'Publication impossible : ' + (d.error || 'réessaie') + '.'; }
      } catch (e) { $('#pub-msg').textContent = 'Connexion perdue, réessaie.'; }
      btn.disabled = false; btn.textContent = o;
    });

    $('#loginBtn').addEventListener('click', connect);
    secretEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') connect(); });
    $('#logout').addEventListener('click', () => { try { localStorage.removeItem('mod_secret'); } catch (e) {} location.reload(); });
    if (secretEl.value) connect();
  </script>
</body>
</html>
