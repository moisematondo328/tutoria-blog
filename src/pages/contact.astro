---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { SOCIALS } from '../consts';
---

<BaseLayout title="Contact" description="Une question, une suggestion, une collaboration ? Écris-nous.">
  <section class="banner">
    <div class="wrap">
      <span class="eyebrow">Nous sommes à ton écoute</span>
      <h1>Nous contacter</h1>
    </div>
  </section>

  <div class="contact-grid">
    <div>
      <p style="color:var(--muted);font-size:1.08rem;margin-top:0">
        Une question, une suggestion ou une opportunité de collaboration ? Remplis le formulaire —
        on te répond vite.
      </p>

      <ul class="info-list">
        <li><span class="ic"><Icon name="chat" /></span><div><b>Écris-nous</b><span>Formulaire ci-dessous — réponse sous 48 h</span></div></li>
        <li><span class="ic"><Icon name="author" /></span><div><b>Communauté</b><span>Rejoins-nous sur les réseaux</span></div></li>
        <li><span class="ic"><Icon name="bolt" /></span><div><b>Collaborations</b><span>Partenariats, sponsoring, interventions</span></div></li>
      </ul>

      <form class="form-card w3form" style="margin-top:22px"
        action="https://api.web3forms.com/submit" method="POST"
        data-success="✅ Merci ! Ton message est bien parti — on te répond vite.">
        <input type="hidden" name="access_key" value="bdb279ee-0299-4b3a-985a-e8ee91257ba0" />
        <input type="hidden" name="subject" value="Nouveau message — Contact Tutoria News" />
        <input type="hidden" name="from_name" value="Site Tutoria News" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <label for="nom">Nom complet</label>
        <input id="nom" name="name" required />
        <label for="email">Adresse email</label>
        <input id="email" type="email" name="email" required />
        <label for="sujet">Sujet</label>
        <input id="sujet" name="Sujet" />
        <label for="message">Votre message</label>
        <textarea id="message" name="message" required></textarea>
        <button class="submit" type="submit">Soumettre le formulaire</button>
        <p class="form-msg" style="color:#eafffb;margin:12px 0 0;font-size:.9rem;font-weight:600"></p>
      </form>

      <p style="margin-top:18px">
        <strong>Suivez-nous :</strong>
        <a href={SOCIALS.facebook}>Facebook</a> ·
        <a href={SOCIALS.tiktok}>TikTok</a> ·
        <a href={SOCIALS.youtube}>YouTube</a>
      </p>
    </div>
    <Newsletter />
  </div>
</BaseLayout>
