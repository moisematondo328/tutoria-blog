---
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import { getCollection } from 'astro:content';
import { PILLARS, pillarByName } from '../../../consts';

// HUB COURS : uniquement les séries `kind === 'cours'` (payant, dirigées par un expert).
// Distinct des tutoriels gratuits (/academy/bibliotheque) et des articles (/academy/articles).
const cours = (await getCollection('courses', ({ data }) => !data.draft && data.kind === 'cours'))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const lessonCount = (id: string) => lessons.filter((l) => l.data.course === id).length;
const colorOf = (cat: string) => pillarByName(cat)?.color || '#0E8074';
---

<AcademyLayout title="Cours" description="Des cours dirigés par un expert : un parcours complet, avec accompagnement. La version approfondie des tutoriels.">
  <section class="ac-crs-hero">
    <span class="ac-eyebrow">Cours Tutoria</span>
    <h1 class="ac-display">Va plus loin, <span class="ac-hl">avec un expert.</span></h1>
    <p>Les tutoriels sont gratuits et te lancent. Les <b>cours</b>, c'est l'étape d'après : un parcours complet, structuré et suivi par un expert du domaine. C'est la partie qui se prépare, et qui se paie.</p>
    <div class="ac-crs-cta">
      <a class="ac-btn ac-btn-primary" href="/academy/accompagnement/">Voir l'accompagnement →</a>
      <a class="ac-btn ac-btn-ghost" href="/academy/bibliotheque/">Commencer par un tutoriel gratuit</a>
    </div>
  </section>

  {cours.length === 0 ? (
    <section class="ac-crs-soon">
      <div class="ac-crs-soon-card">
        <span class="ac-crs-soon-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 8v6M7 10.5V15c0 1.1 2.2 2.5 5 2.5s5-1.4 5-2.5v-4.5"/></svg></span>
        <h2>Les premiers cours arrivent</h2>
        <p>Nos experts préparent des cours complets, domaine par domaine. En attendant, tout est déjà ouvert côté tutoriels, gratuitement.</p>
        <div class="ac-crs-doms">
          {PILLARS.map((p) => (
            <a href={`/academy/bibliotheque/#${p.slug}`} style={`--c:${p.color}`}><span class="ac-crs-dot"></span>{p.name}</a>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="ac-crs-grid">
      {cours.map((c) => (
        <a class="ac-crs-card" href={`/academy/${c.id}/`} style={`--c:${colorOf(c.data.category)}`}>
          <div class="ac-crs-top">
            <span class="ac-crs-dom"><span class="ac-crs-dot"></span>{c.data.category}</span>
            <span class="ac-crs-paid">Payant</span>
          </div>
          <h3>{c.data.title}</h3>
          <p>{c.data.excerpt}</p>
          <div class="ac-crs-meta">
            {c.data.expert && <span>Par {c.data.expert}</span>}
            <span>{lessonCount(c.id)} leçon{lessonCount(c.id) > 1 ? 's' : ''}</span>
            <span>{c.data.level}</span>
          </div>
        </a>
      ))}
    </section>
  )}
</AcademyLayout>

<style>
  .ac-crs-hero { max-width: 720px; margin: 56px auto 8px; text-align: center; }
  .ac-crs-hero .ac-eyebrow { display: block; margin-bottom: 14px; }
  .ac-crs-hero h1 { font-size: clamp(2rem, 4.4vw, 3rem); letter-spacing: -.03em; line-height: 1.04; margin: 0 0 16px; }
  .ac-crs-hero p { color: var(--ac-ink-soft); font-size: 1.08rem; line-height: 1.6; margin: 0 0 26px; }
  .ac-crs-hero b { color: var(--ac-ink); }
  .ac-crs-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  .ac-crs-soon { margin: 40px 0 24px; }
  .ac-crs-soon-card { max-width: 620px; margin: 0 auto; text-align: center; background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: var(--ac-radius-lg); box-shadow: var(--ac-shadow-sm); padding: 40px 30px; }
  .ac-crs-soon-ic { display: inline-flex; width: 60px; height: 60px; border-radius: 50%; background: color-mix(in srgb, var(--ac-teal) 12%, var(--ac-surface)); color: var(--ac-teal); align-items: center; justify-content: center; margin-bottom: 16px; }
  .ac-crs-soon-ic svg { width: 30px; height: 30px; }
  .ac-crs-soon-card h2 { font-family: var(--ac-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -.02em; margin: 0 0 10px; }
  .ac-crs-soon-card p { color: var(--ac-ink-soft); line-height: 1.6; margin: 0 0 22px; }
  .ac-crs-doms { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .ac-crs-doms a { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: .9rem; color: var(--ac-ink); text-decoration: none; background: var(--ac-paper); border: 1px solid var(--ac-line); border-radius: 999px; padding: 8px 15px; transition: border-color .14s; }
  .ac-crs-doms a:hover { border-color: var(--c); }
  .ac-crs-dot { width: 9px; height: 9px; border-radius: 2px; transform: rotate(45deg); background: var(--c); flex: 0 0 auto; }

  .ac-crs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 40px 0 24px; }
  .ac-crs-card { display: flex; flex-direction: column; gap: 8px; background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: var(--ac-radius); box-shadow: var(--ac-shadow-sm); padding: 22px; text-decoration: none; color: inherit; transition: transform .16s, border-color .16s, box-shadow .16s; }
  .ac-crs-card:hover { transform: translateY(-4px); border-color: var(--c); box-shadow: var(--ac-shadow-lg); }
  .ac-crs-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .ac-crs-dom { display: inline-flex; align-items: center; gap: 7px; font-size: .74rem; font-weight: 700; color: var(--c); }
  .ac-crs-paid { font-size: .64rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--ac-dark); background: var(--ac-yellow); padding: 3px 9px; border-radius: 999px; }
  .ac-crs-card h3 { font-family: var(--ac-display); font-weight: 800; font-size: 1.12rem; letter-spacing: -.01em; line-height: 1.24; margin: 4px 0 0; color: var(--ac-ink); }
  .ac-crs-card p { color: var(--ac-muted); font-size: .9rem; line-height: 1.5; margin: 0; flex: 1; }
  .ac-crs-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 6px; color: var(--ac-ink-soft); font-size: .8rem; font-weight: 600; }
  @media (max-width: 860px) { .ac-crs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ac-crs-grid { grid-template-columns: 1fr; } }
</style>
