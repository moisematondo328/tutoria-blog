---
import { getCollection, render } from 'astro:content';
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import AcademyTree from '../../../components/AcademyTree.astro';
import { pillarByName } from '../../../consts';

export async function getStaticPaths() {
  const slugOf = (id: string) => id.split('/').pop() as string;
  const allCourses = await getCollection('courses', ({ data }) => !data.draft);
  const allLessons = await getCollection('lessons', ({ data }) => !data.draft);
  const lessonsOf = (cid: string) =>
    allLessons.filter((l) => l.data.course === cid).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

  const paths: any[] = [];
  for (const course of allCourses) {
    const pslug = pillarByName(course.data.category)?.slug;
    const pillarCourses = allCourses
      .filter((c) => pillarByName(c.data.category)?.slug === pslug)
      .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
      .map((c) => ({ id: c.id, title: c.data.title, lessons: lessonsOf(c.id).map((l) => ({ slug: slugOf(l.id), title: l.data.title })) }));
    const lessons = lessonsOf(course.id);
    lessons.forEach((lesson, index) => {
      paths.push({
        params: { course: course.id, lesson: slugOf(lesson.id) },
        props: { course, lesson, index, lessons, pillarCourses },
      });
    });
  }
  return paths;
}

const { course, lesson, index, lessons, pillarCourses } = Astro.props;
const slugOf = (id: string) => id.split('/').pop() as string;
const { Content, headings } = await render(lesson);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const pillar = pillarByName(course.data.category);
const prev = index > 0 ? lessons[index - 1] : null;
const next = index < lessons.length - 1 ? lessons[index + 1] : null;
const pct = Math.round(((index + 1) / lessons.length) * 100);
const lessonSlug = slugOf(lesson.id);
---

<AcademyLayout title={`${lesson.data.title} · ${course.data.title}`} description={course.data.excerpt} wide={false}>
  <div class="ac-reader">
    <button class="ac-plan-toggle" id="ac-plan" type="button" aria-label="Afficher le plan du cours">☰ Plan du cours</button>
    <AcademyTree courses={pillarCourses} currentCourse={course.id} currentLesson={lessonSlug} pillarName={pillar?.name} activeHeadings={toc} />

    <article class="ac-article">
      <div class="ac-crumb"><a href="/academy/">Academy</a> › <a href={`/academy/#${pillar?.slug}`}>{course.data.category}</a> › <a href={`/academy/${course.id}/`}>{course.data.title}</a> › <span>{lesson.data.title}</span></div>

      <div class="ac-rownav">
        {prev ? <a href={`/academy/${course.id}/${slugOf(prev.id)}/`}>‹ Précédent</a> : <span></span>}
        <a class="ac-dl" href={`/academy/${course.id}/${lessonSlug}.pdf`} download title="Télécharger cette leçon en PDF">⬇ PDF</a>
        {next ? <a href={`/academy/${course.id}/${slugOf(next.id)}/`}>Suivant ›</a>
              : <a href={`/academy/${course.id}/`}>Fin ✓</a>}
      </div>

      <div class="ac-prog"><span>Leçon {index + 1} / {lessons.length}</span><div class="ac-bar"><i style={`width:${pct}%`}></i></div></div>

      <h1>{lesson.data.title}</h1>

      {toc.length >= 2 && (
        <nav class="ac-toc" aria-label="Sommaire de la leçon">
          <span class="ac-toc-h">Dans cette leçon</span>
          <ol>
            {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}

      <div class="ac-prose-wrap"><div class="prose"><Content /></div></div>

      <div class="ac-done" data-course={course.id} data-lesson={lessonSlug}>
        <button class="ac-done-btn" id="ac-done" type="button" hidden>Marquer comme terminé</button>
        <a class="ac-done-login" id="ac-done-login" href="/academy/compte/connexion/" hidden>Connecte-toi pour suivre ta progression →</a>
      </div>

      {lesson.data.quiz && lesson.data.quiz.length > 0 && (
        <section class="ac-quiz">
          <h2>Vérifie ta compréhension</h2>
          <p class="ac-quiz-sub">Clique la bonne réponse.</p>
          {lesson.data.quiz.map((qz: any) => (
            <div class="ac-quiz-q">
              <p class="ac-quiz-title">{qz.q}</p>
              <div class="ac-quiz-opts">
                {qz.options.map((o: any) => (
                  <button type="button" class="ac-quiz-opt" data-correct={o.correct ? '1' : '0'}>{o.t}</button>
                ))}
              </div>
              <p class="ac-quiz-fb" hidden></p>
            </div>
          ))}
          <p class="ac-quiz-score" hidden></p>
        </section>
      )}

      <nav class="ac-botnav">
        {prev
          ? <a class="p" href={`/academy/${course.id}/${slugOf(prev.id)}/`}><small>Précédent</small><b>{prev.data.title}</b></a>
          : <span></span>}
        {next
          ? <a class="n" href={`/academy/${course.id}/${slugOf(next.id)}/`}><small>Suivant</small><b>{next.data.title}</b></a>
          : <a class="n done" href={`/academy/${course.id}/`}><small>Terminé</small><b>Revoir le cours ✓</b></a>}
      </nav>
    </article>
  </div>
</AcademyLayout>

<style>
  .ac-reader { display: grid; grid-template-columns: 300px 1fr; gap: 34px; align-items: start; padding-top: 22px; }
  #ac-tree { position: sticky; top: 74px; max-height: calc(100vh - 96px); overflow-y: auto; }
  .ac-article { min-width: 0; }
  .ac-crumb { font-size: .84rem; color: var(--ac-muted); margin-bottom: 14px; }
  .ac-crumb a { color: var(--ac-muted); text-decoration: none; }
  .ac-crumb a:hover { color: var(--ac-teal); }
  .ac-crumb span { color: var(--ac-ink); }
  .ac-rownav { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .ac-rownav > a, .ac-dl { font-size: .86rem; font-weight: 700; text-decoration: none; color: var(--ac-teal); background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: 9px; padding: 7px 13px; cursor: pointer; font-family: inherit; }
  .ac-rownav > a:hover, .ac-dl:hover { border-color: var(--ac-teal); }
  .ac-dl { color: var(--ac-ink); }
  .ac-prog { margin-bottom: 16px; }
  .ac-prog span { font-size: .8rem; font-weight: 700; color: var(--ac-teal); }
  .ac-bar { height: 6px; background: var(--ac-line); border-radius: 999px; overflow: hidden; margin-top: 6px; }
  .ac-bar i { display: block; height: 100%; background: var(--ac-teal-l); }
  .ac-article h1 { font-family: var(--ac-display); font-weight: 800; letter-spacing: -0.025em; font-size: 2.2rem; line-height: 1.08; margin: 6px 0 20px; }
  .ac-botnav { display: flex; justify-content: space-between; gap: 14px; margin-top: 40px; padding-top: 22px; border-top: 1px solid var(--ac-line); }
  .ac-botnav a { display: flex; flex-direction: column; gap: 3px; max-width: 48%; background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: 12px; padding: 12px 16px; text-decoration: none; color: var(--ac-ink); transition: border-color .15s; }
  .ac-botnav a:hover { border-color: var(--ac-teal); }
  .ac-botnav a.n { margin-left: auto; text-align: right; }
  .ac-botnav small { color: var(--ac-muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .5px; }
  .ac-botnav b { font-weight: 700; }
  .ac-botnav a.done { background: var(--ac-teal); color: #fff; border-color: var(--ac-teal); }
  .ac-botnav a.done small { color: rgba(255,255,255,.8); }
  .ac-plan-toggle { display: none; font-family: inherit; font-weight: 700; font-size: .88rem; color: var(--ac-teal); background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: 10px; padding: 10px 14px; cursor: pointer; margin-bottom: 4px; }
  @media (max-width: 860px) {
    .ac-reader { grid-template-columns: 1fr; }
    .ac-plan-toggle { display: block; }
    #ac-tree { position: static; max-height: none; display: none; margin-bottom: 18px; }
    #ac-tree.mobile-open { display: block; }
  }
  .ac-done { margin: 26px 0 4px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .ac-done-btn { font-family: inherit; font-weight: 700; font-size: .92rem; cursor: pointer; border: 1.5px solid var(--ac-teal); color: var(--ac-teal); background: var(--ac-surface); border-radius: 11px; padding: 11px 20px; transition: background .15s, color .15s; }
  .ac-done-btn:hover:not(:disabled) { background: color-mix(in srgb, var(--ac-teal) 8%, var(--ac-surface)); }
  .ac-done-btn.is-done { background: var(--ac-teal); color: #fff; }
  .ac-done-login { font-weight: 600; font-size: .9rem; color: var(--ac-teal); text-decoration: none; }
  .ac-done-login:hover { text-decoration: underline; }

  .ac-premium-tag { display: inline-block; background: var(--ac-yellow); color: var(--ac-dark); font-weight: 700; font-size: .72rem; padding: 3px 10px; border-radius: 999px; margin-bottom: 6px; }
  .ac-lock { margin: 4px 0 8px; }
  .ac-lock-card { text-align: center; border: 1px solid var(--ac-line); background: var(--ac-surface); border-radius: 18px; padding: 32px 26px; box-shadow: var(--ac-shadow-sm); }
  .ac-lock-ic { color: var(--ac-teal); margin-bottom: 10px; display: flex; justify-content: center; }
  .ac-lock-card h3 { font-family: var(--ac-display); font-weight: 800; font-size: 1.35rem; margin: 0 0 8px; }
  .ac-lock-card p { color: var(--ac-ink-soft); max-width: 46ch; margin: 0 auto 18px; line-height: 1.6; }
  .ac-article.is-locked .ac-prose-wrap { position: relative; max-height: 300px; overflow: hidden; -webkit-mask-image: linear-gradient(#000 52%, transparent); mask-image: linear-gradient(#000 52%, transparent); }
  .ac-article.is-locked .ac-dl { visibility: hidden; }

  /* Sommaire d'ancres */
  .ac-toc { background: var(--ac-surface); border: 1px solid var(--ac-line); border-left: 4px solid var(--ac-teal); border-radius: 12px; padding: 14px 18px; margin: 0 0 26px; max-width: 72ch; }
  .ac-toc-h { font-family: var(--ac-display); font-weight: 700; font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ac-teal); }
  .ac-toc ol { margin: 8px 0 0; padding: 0; list-style: none; counter-reset: toc; }
  .ac-toc li { margin: 3px 0; }
  .ac-toc li.d3 { padding-left: 16px; }
  .ac-toc li::before { counter-increment: toc; content: counter(toc, decimal-leading-zero); color: var(--ac-teal); font-weight: 700; font-size: .78rem; margin-right: 8px; }
  .ac-toc li.d3::before { content: "›"; }
  .ac-toc a { color: var(--ac-ink-soft); text-decoration: none; font-size: .92rem; }
  .ac-toc a:hover { color: var(--ac-teal); text-decoration: underline; }

  @media print {
    .ac-top, .ac-foot, #ac-tree, .ac-rownav, .ac-botnav, .ac-prog, .ac-done, .ac-toc, .ac-code-bar { display: none !important; }
    .ac-reader { grid-template-columns: 1fr; }
  }
</style>

<script>
  function acFmt(v) { return typeof v === 'string' ? v : (() => { try { return JSON.stringify(v); } catch { return String(v); } })(); }
  function acEsc(s) { return String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
  function runInline(src, wrap) {
    let out = wrap.querySelector('.ac-code-output');
    if (!out) { out = document.createElement('div'); out.className = 'ac-code-output'; wrap.appendChild(out); }
    const lines = [];
    const push = (t, cls) => lines.push(cls ? `<span class="${cls}">${acEsc(t)}</span>` : acEsc(t));
    const cons = { log: (...a) => push(a.map(acFmt).join(' ')), info: (...a) => push(a.map(acFmt).join(' ')), warn: (...a) => push(a.map(acFmt).join(' ')), error: (...a) => push(a.map(acFmt).join(' '), 'err') };
    try {
      const fn = new Function('console', '"use strict";\n' + src);
      const r = fn(cons);
      if (r !== undefined) push('⟵ ' + acFmt(r), 'ok');
    } catch (e) { push((e && e.name ? e.name + ': ' : 'Erreur : ') + (e && e.message ? e.message : e), 'err'); }
    out.innerHTML = lines.join('\n') || '<span style="opacity:.55">(aucune sortie)</span>';
  }
  function enhanceCode(root) {
    root.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.closest('.ac-codewrap')) return;
      const code = pre.querySelector('code');
      if (!code) return;
      let lang = pre.getAttribute('data-language') || '';
      if (!lang && code.className) { const m = code.className.match(/language-([\w-]+)/); if (m) lang = m[1]; }
      lang = lang || 'code';
      const wrap = document.createElement('div');
      wrap.className = 'ac-codewrap';
      pre.parentNode.insertBefore(wrap, pre);
      const bar = document.createElement('div');
      bar.className = 'ac-code-bar';
      bar.innerHTML = `<span class="ac-code-id"><span class="ac-code-dots"><i></i><i></i><i></i></span><span class="ac-code-lang">${acEsc(lang)}</span></span><span class="ac-code-btns"></span>`;
      wrap.appendChild(bar);
      wrap.appendChild(pre);
      const btns = bar.querySelector('.ac-code-btns');
      const copy = document.createElement('button');
      copy.type = 'button'; copy.textContent = 'Copier';
      copy.addEventListener('click', async () => { try { await navigator.clipboard.writeText(code.innerText); copy.textContent = 'Copié ✓'; setTimeout(() => { copy.textContent = 'Copier'; }, 1500); } catch {} });
      btns.appendChild(copy);
      if (/^(js|javascript)$/i.test(lang)) {
        const run = document.createElement('button');
        run.type = 'button'; run.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg> Exécuter';
        run.addEventListener('click', () => runInline(code.innerText, wrap));
        btns.appendChild(run);
      }
    });
  }
  async function readerBoot() {
    const plan = document.getElementById('ac-plan');
    if (plan && !plan.dataset.bound) { plan.dataset.bound = '1'; plan.addEventListener('click', () => { document.getElementById('ac-tree')?.classList.toggle('mobile-open'); }); }

    const article = document.querySelector('.ac-article');
    if (!article || article.dataset.bound) return;
    article.dataset.bound = '1';

    enhanceCode(article);

    let me = null;
    try { me = (await (await fetch('/api/auth/me')).json()).user; } catch {}

    // Progression
    const wrap = document.querySelector('.ac-done');
    if (!wrap) return;
    const btn = document.getElementById('ac-done');
    const login = document.getElementById('ac-done-login');
    const course = wrap.dataset.course, lesson = wrap.dataset.lesson;
    if (!me) { login.hidden = false; return; }
    let done = false;
    try { const pd = await (await fetch('/api/progress')).json(); if (pd.ok) done = !!pd.progress[`${course}/${lesson}`]; } catch {}
    const render = () => { btn.textContent = done ? '✓ Leçon terminée' : 'Marquer comme terminé'; btn.classList.toggle('is-done', done); };
    btn.hidden = false; render();
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const next = !done;
      try { const d = await (await fetch('/api/progress', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ course, lesson, done: next }) })).json(); if (d.ok) { done = next; render(); } } catch {}
      btn.disabled = false;
    });
  }
  document.addEventListener('astro:page-load', readerBoot);
</script>
