---
import { getCollection } from 'astro:content';
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import { PILLARS, pillarByName } from '../../consts';

const courses = (await getCollection('courses', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const lessonCount = (id: string) => lessons.filter((l) => l.data.course === id).length;
const byPillar = PILLARS.map((p) => ({
  pillar: p,
  list: courses.filter((c) => pillarByName(c.data.category)?.slug === p.slug),
}));
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<AcademyLayout title="Apprends, comprends, applique">
  <section class="ac-hero">
    <svg class="ac-hero-arc" viewBox="0 0 600 600" fill="none" aria-hidden="true">
      <path d="M60 540 C 60 220, 300 60, 560 90" stroke="var(--ac-teal-l)" stroke-width="26" stroke-linecap="round" opacity="0.28"/>
      <path d="M120 560 C 140 300, 340 150, 560 200" stroke="var(--ac-yellow)" stroke-width="22" stroke-linecap="round" opacity="0.5"/>
    </svg>
    <span class="ac-eyebrow">Tutoria Academy</span>
    <h1 class="ac-display">Apprends. Comprends. <span class="hl">Applique.</span></h1>
    <p>La plateforme qui transforme le savoir en compétences concrètes. Choisis ton domaine, suis le chemin pas à pas, avance à ton rythme. Et emporte chaque cours avec toi.</p>
    <div class="ac-hero-actions">
      <a class="ac-btn ac-btn-primary" href="#catalogue">Explorer les cours →</a>
      <a class="ac-btn ac-btn-ghost" href="/articles/">Lire les articles</a>
    </div>
  </section>

  <section class="ac-pillars">
    {byPillar.map(({ pillar, list }, i) => (
      <a class="ac-pillar" href={`#${pillar.slug}`} style={`--c:${pillar.color}`}>
        <span class="ac-pnum">{pad(i)}</span>
        <h3>{pillar.name}</h3>
        <p>{pillar.blurb}</p>
        <span class="ac-pcount">{list.length} cours →</span>
      </a>
    ))}
  </section>

  <div id="ac-lib" aria-hidden="false">
    <div id="catalogue"></div>
    {byPillar.map(({ pillar, list }) => (
      <section class="ac-sec" id={pillar.slug} data-pillar-block style={`--c:${pillar.color}`}>
        <div class="ac-sec-head">
          <h2>{pillar.name}</h2>
          <span class="ac-sec-count">{list.length} cours</span>
        </div>
        {list.length === 0
          ? <p class="ac-soon">Parcours en préparation par notre expert.</p>
          : (
            <div class="ac-grid">
              {list.map((c) => (
                <a class="ac-card" href={`/academy/${c.id}/`} style={`--c:${pillar.color}`} data-search={(c.data.title + ' ' + c.data.excerpt + ' ' + c.data.category + ' ' + c.data.expert).toLowerCase()}>
                  <div class="ac-card-top">
                    {c.data.cover && <img src={c.data.cover} alt="" />}
                    <span class="ac-card-lvl">{c.data.level}</span>
                  </div>
                  <div class="ac-card-b">
                    <h3>{c.data.title}</h3>
                    <p>{c.data.excerpt}</p>
                    <div class="ac-card-m">
                      <span class="ac-c-lessons">{lessonCount(c.id)} leçon{lessonCount(c.id) > 1 ? 's' : ''}</span>
                      {c.data.expert && <span class="ac-c-exp">{c.data.expert}</span>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )}
      </section>
    ))}
  </div>
</AcademyLayout>
