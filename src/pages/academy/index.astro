---
import { getCollection } from 'astro:content';
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import { PILLARS, EXPERTS, pillarByName, catSlugOf } from '../../consts';
import Ico from '../../components/Ico.astro';
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

const PH: Record<string, string> = {
  'sante-bien-etre': 'ph:heartbeat-duotone',
  'developpement-personnel': 'ph:trend-up-duotone',
  'finance-investissement': 'ph:coins-duotone',
  'technologie-emergente': 'ph:cpu-duotone',
};

const courses = (await getCollection('courses', ({ data }) => !data.draft)).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const lessonCount = (id: string) => lessons.filter((l) => l.data.course === id).length;
const coursesOf = (slug: string) => courses.filter((c) => pillarByName(c.data.category)?.slug === slug);
const articles = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()).slice(0, 10);

// Parcours guidés : le cours phare de chaque domaine + ses étapes (leçons)
const slugOfLesson = (id: string) => id.split('/').pop() as string;
const lessonsOfCourse = (id: string) => lessons.filter((l) => l.data.course === id).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const paths = PILLARS.map((p) => {
  const c = coursesOf(p.slug)[0] || null;
  return { pillar: p, course: c, steps: c ? lessonsOfCourse(c.id) : [] };
});

const GRAD: Record<string, string[]> = {
  'sante-bien-etre': ['#12A594', '#0B6E64'],
  'developpement-personnel': ['#E0A400', '#A9760A'],
  'finance-investissement': ['#0E8074', '#0A3F3A'],
  'technologie-emergente': ['#19B7A0', '#0E8074'],
};
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<AcademyLayout title="Apprends, comprends, applique">
  <!-- HERO -->
  <section class="ac-hero2">
    <div>
      <span class="ac-eyebrow">Tutoria Academy</span>
      <h1 class="ac-display" style="font-size:clamp(2.4rem,5vw,4rem);line-height:.98;letter-spacing:-.03em;margin:14px 0 18px">Apprends. Comprends. <span class="ac-hl">Applique.</span></h1>
      <p style="font-size:1.15rem;line-height:1.6;color:var(--ac-ink-soft);max-width:46ch;margin:0 0 26px">La plateforme d'apprentissage francophone. Choisis ton domaine, suis le chemin pas à pas, et emporte chaque cours avec toi.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="ac-btn ac-btn-primary" href="#catalogue">Explorer les cours →</a>
        <a class="ac-btn ac-btn-ghost" href="/academy/articles/">Lire les articles</a>
      </div>
    </div>
    <div class="ac-h-illu" aria-hidden="true">
      <svg class="ac-hi-thread" viewBox="0 0 460 460" preserveAspectRatio="none">
        <path d="M70 60 C 300 40, 180 230, 400 210 C 200 235, 300 430, 60 420" fill="none" stroke="var(--ac-line-strong)" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round"/>
      </svg>

      <div class="ac-hi-card hi-budget">
        <span class="hi-cap">Ton budget, clair</span>
        <div class="hi-bar"><i style="width:50%;background:var(--ac-teal)"></i><i style="width:30%;background:var(--ac-yellow)"></i><i style="width:20%;background:var(--ac-teal-l)"></i></div>
        <div class="hi-legend"><span>50% Besoins</span><span>30% Envies</span><span>20% Avenir</span></div>
      </div>

      <div class="ac-hi-card hi-code">
        <div class="hi-dots"><i></i><i></i><i></i></div>
        <pre><span class="k">const</span> toi = <span class="f">apprendre</span>();
toi.<span class="f">comprendre</span>();
toi.<span class="f">appliquer</span>();</pre>
      </div>

      <div class="ac-hi-card hi-streak">
        <span class="hi-cap">Ta régularité</span>
        <div class="hi-days"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i class="on"></i><i class="on"></i></div>
        <small>5 jours d'affilée</small>
      </div>

      <div class="ac-hi-card hi-pulse">
        <span class="hi-cap">Bien-être</span>
        <svg class="hi-ecg" viewBox="0 0 130 34"><path d="M2 18 H30 l6 -13 l8 26 l6 -18 H84 l5 -6 l6 8 H128" fill="none" stroke="var(--ac-teal)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>

      <span class="ac-hi-chip" style="top:118px;right:2px">Santé</span>
      <span class="ac-hi-chip" style="bottom:70px;left:0">Argent</span>
      <span class="ac-hi-chip" style="bottom:6px;left:150px">Mental</span>
      <span class="ac-hi-chip" style="top:96px;left:176px">Tech</span>
    </div>
  </section>

  <!-- FEATURES : les 4 domaines -->
  <section class="ac-features">
    {PILLARS.map((p) => {
      const g = GRAD[p.slug] || ['#0E8074', '#0A3F3A'];
      const n = coursesOf(p.slug).length;
      return (
        <a class="ac-feat" href={`/academy/bibliotheque/#${p.slug}`} style={`--c1:${g[0]};--c2:${g[1]}`}>
          <span class="ac-feat-badge">{n > 0 ? `${n} cours` : 'Bientôt'}</span>
          <span class="ac-feat-ic"><Ico name={PH[p.slug]} /></span>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
          <span class="ac-feat-go">Explorer →</span>
        </a>
      );
    })}
  </section>

  <!-- PARCOURS GUIDÉS (façon "Learning Paths") -->
  <section class="ac-paths" id="catalogue">
    <div class="ac-paths-head">
      <h2 class="ac-display">Parcours <span class="em">guidés</span></h2>
      <p>Un chemin clair, leçon après leçon. Tu choisis, tu avances, tu appliques.</p>
    </div>
    <div class="ac-paths-grid">
      {paths.map(({ pillar, course, steps }) => (
        <div class="ac-path-card" style={`--c:${pillar.color}`}>
          <div class="ac-path-top">
            <span class="ac-path-dom"><span class="dot"></span>{pillar.name}</span>
            {course ? <span class="ac-path-lvl">{course.data.level}</span> : <span class="ac-path-lvl soon">Bientôt</span>}
          </div>
          {course ? (
            <>
              <h3>{course.data.title}</h3>
              <p class="ac-path-exp">{course.data.expert ? `Avec ${course.data.expert} · ` : ''}{steps.length} leçon{steps.length > 1 ? 's' : ''}</p>
              <ol class="ac-path-steps">
                {steps.slice(0, 5).map((l) => (
                  <li><a href={`/academy/${course.id}/${slugOfLesson(l.id)}/`}>{l.data.title}</a></li>
                ))}
              </ol>
              <a class="ac-path-cta" href={`/academy/${course.id}/`}>Commencer le parcours →</a>
            </>
          ) : (
            <>
              <h3>Parcours {pillar.name.split(' ')[0]}</h3>
              <p class="ac-path-exp">Animé par l'expert du domaine</p>
              <ol class="ac-path-steps ghost" aria-hidden="true">
                <li><span class="sk"></span></li>
                <li><span class="sk"></span></li>
                <li><span class="sk"></span></li>
              </ol>
              <a class="ac-path-cta" href={`/academy/bibliotheque/#${pillar.slug}`}>Découvrir le domaine →</a>
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- NOS EXPERTS (carrousel Swiper) -->
  <section class="ac-band">
    <div class="ac-band-head">
      <div><h2>Nos <span class="em">experts</span></h2><p>Un visage par domaine. Ce sont eux qui t'accompagnent.</p></div>
      <a class="ac-band-more" href="/academy/accompagnement/">Se faire accompagner →</a>
    </div>
    <div class="swiper ac-swiper" id="sw-experts">
      <div class="swiper-wrapper">
        {EXPERTS.map((e) => {
          const pil = pillarByName(e.pillar);
          return (
            <a class="swiper-slide ac-xp" href={`/academy/expert/${e.slug}/`} style={`--c:${pil?.color || 'var(--ac-teal)'}`}>
              <span class="ac-xp-av">{initials(e.name)}</span>
              <b>{e.name}</b>
              <small>{e.role}</small>
              <span class="ac-xp-dom">{e.pillar}</span>
            </a>
          );
        })}
      </div>
      <div class="ac-sw-ctrl"><button class="ac-sw-prev" type="button" aria-label="Précédent">‹</button><div class="swiper-pagination"></div><button class="ac-sw-next" type="button" aria-label="Suivant">›</button></div>
    </div>
  </section>

  <!-- DERNIERS ARTICLES (carrousel Swiper) -->
  {articles.length > 0 && (
    <section class="ac-band">
      <div class="ac-band-head">
        <div><h2>Derniers <span class="em">articles</span></h2><p>À lire vite, entre deux leçons.</p></div>
        <a class="ac-band-more" href="/academy/articles/">Tous les articles →</a>
      </div>
      <div class="swiper ac-swiper" id="sw-articles">
        <div class="swiper-wrapper">
          {articles.map((a) => (
            <a class="swiper-slide ac-art" href={`/academy/articles/${a.id}/`}>
              <div class="ac-art-cov">{a.data.cover && <img src={a.data.cover} alt="" loading="lazy" decoding="async" />}</div>
              <div class="ac-art-b"><span class="ac-art-cat">{a.data.category}</span><h3>{a.data.title}</h3></div>
            </a>
          ))}
        </div>
        <div class="ac-sw-ctrl"><button class="ac-sw-prev" type="button" aria-label="Précédent">‹</button><div class="swiper-pagination"></div><button class="ac-sw-next" type="button" aria-label="Suivant">›</button></div>
      </div>
    </section>
  )}
</AcademyLayout>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, A11y, Autoplay } from 'swiper/modules';

  function initSwipers() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.ac-swiper').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      const experts = el.id === 'sw-experts';
      new Swiper(el, {
        modules: [Navigation, Pagination, A11y, Autoplay],
        slidesPerView: 1.15,
        spaceBetween: 16,
        grabCursor: true,
        breakpoints: {
          560: { slidesPerView: 2, spaceBetween: 18 },
          900: { slidesPerView: 3, spaceBetween: 20 },
          1200: { slidesPerView: experts ? 4 : 3.2, spaceBetween: 20 },
        },
        pagination: { el: el.querySelector('.swiper-pagination'), clickable: true },
        navigation: { prevEl: el.querySelector('.ac-sw-prev'), nextEl: el.querySelector('.ac-sw-next') },
        autoplay: reduce ? false : { delay: 5000, disableOnInteraction: true, pauseOnMouseEnter: true },
        a11y: { enabled: true },
      });
    });
  }
  document.addEventListener('astro:page-load', initSwipers);
</script>
