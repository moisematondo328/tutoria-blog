---
import AcademyLayout from '../../../layouts/AcademyLayout.astro';

const ic = {
  code: '<polyline points="8 8 4 12 8 16"/><polyline points="16 8 20 12 16 16"/>',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="7 9 10 12 7 15"/><line x1="13" y1="15" x2="17" y2="15"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>',
  chart: '<path d="M4 4v16h16"/><polyline points="7 14 11 9 14 12 19 6"/>',
};
const tools = [
  { name: 'Compilateur en ligne', href: '/academy/outils/compilateur/', svg: ic.code, desc: 'Écris et exécute du code dans ton navigateur. JavaScript tourne en direct.', status: 'JS en direct' },
  { name: 'Code de pratique', href: '/academy/outils/pratique/', svg: ic.terminal, desc: 'Des exercices guidés, vérifiés automatiquement pendant que tu codes.', status: 'Disponible' },
  { name: 'Tableau blanc', href: '/academy/outils/tableau-blanc/', svg: ic.pen, desc: 'Un espace pour schématiser une idée, un budget, un plan. Puis télécharge.', status: 'Disponible' },
  { name: 'Calculatrice graphique', href: '/academy/outils/calculatrice/', svg: ic.chart, desc: 'Écris une fonction et vois sa courbe. Zoome, compare, comprends.', status: 'Disponible' },
];
---

<AcademyLayout title="Outils">
  <section style="padding:44px 0 8px">
    <span class="ac-eyebrow">Tutoria Academy</span>
    <h1 class="ac-display" style="font-size:2.4rem;letter-spacing:-.03em;margin:12px 0 8px">Outils</h1>
    <p style="color:var(--ac-ink-soft);max-width:52ch;margin:0">Apprendre, c'est faire. Entraîne-toi directement sur la plateforme.</p>
  </section>

  <div class="ac-tiles" style="margin-top:24px">
    {tools.map((t) => (
      <a class="ac-tool" href={t.href}>
        <span class="ac-tool-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={t.svg}></svg></span>
        <div class="ac-tool-b">
          <div class="ac-tool-top"><b>{t.name}</b><span class="ac-tool-ok">{t.status}</span></div>
          <p>{t.desc}</p>
        </div>
      </a>
    ))}
  </div>
</AcademyLayout>

<style>
  .ac-tool { display: flex; gap: 16px; align-items: flex-start; background: var(--ac-surface); border: 1px solid var(--ac-line); border-radius: 16px; padding: 20px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .ac-tool:hover { border-color: var(--ac-teal); transform: translateY(-2px); }
  .ac-tool-ic { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 13px; background: color-mix(in srgb, var(--ac-teal) 12%, var(--ac-surface)); color: var(--ac-teal); display: flex; align-items: center; justify-content: center; }
  .ac-tool-ic svg { width: 23px; height: 23px; }
  .ac-tool-top { display: flex; align-items: center; gap: 10px; }
  .ac-tool-b b { font-family: var(--ac-display); font-weight: 700; font-size: 1.08rem; }
  .ac-tool-ok { background: color-mix(in srgb, var(--ac-teal) 14%, var(--ac-surface)); color: var(--ac-teal-d); font-weight: 700; font-size: .68rem; padding: 3px 9px; border-radius: 999px; }
  .ac-tool-b p { margin: 6px 0 0; color: var(--ac-muted); font-size: .92rem; line-height: 1.45; }
</style>
