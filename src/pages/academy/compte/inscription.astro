---
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import { turnstileSiteKey } from '../../../lib/turnstile';
const siteKey = turnstileSiteKey();
---

<AcademyLayout title="Créer un compte" description="Crée ton compte Tutoria Academy pour suivre ta progression.">
  <div class="ac-auth-wrap">
    <div class="ac-auth-head">
      <span class="ac-auth-eyebrow">Tutoria Academy</span>
      <h1>Crée ton compte</h1>
      <p>Suis ta progression, reprends où tu t'es arrêté.</p>
    </div>
    <div class="ac-auth-card">
      <div class="ac-msg err" id="msg"></div>
      <form id="form" novalidate>
        <div class="ac-field"><label for="name">Ton prénom</label><input id="name" name="name" type="text" autocomplete="given-name" placeholder="Ex. Salem" required /></div>
        <div class="ac-field"><label for="email">Adresse e-mail</label><input id="email" name="email" type="email" autocomplete="email" placeholder="toi@exemple.com" required /></div>
        <div class="ac-field"><label for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="new-password" placeholder="8 caractères minimum" minlength="8" required /></div>
        <div id="ts-widget" class="cf-turnstile ac-ts" data-sitekey={siteKey} data-theme="auto"></div>
        <button class="ac-auth-btn" type="submit" id="submit">Créer mon compte</button>
      </form>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad&render=explicit" async defer is:inline></script>
      <div class="ac-or">ou</div>
      <a class="ac-google" href="/api/auth/google">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continuer avec Google
      </a>
      <div class="ac-auth-links">Déjà un compte ? <a href="/academy/compte/connexion/">Se connecter</a></div>
    </div>
  </div>
</AcademyLayout>

<script>
  let regWid = null;
  function renderRegTs() {
    const host = document.getElementById('ts-widget');
    if (!host || host.dataset.rendered || !window.turnstile) return;
    host.dataset.rendered = '1';
    regWid = window.turnstile.render(host, { sitekey: host.dataset.sitekey, theme: 'auto' });
  }
  window.onTurnstileLoad = renderRegTs;

  function bind() {
    renderRegTs();
    const form = document.getElementById('form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    const msg = document.getElementById('msg');
    const btn = document.getElementById('submit');
    const errors = {
      email: "Cette adresse e-mail n'est pas valide.",
      password: 'Ton mot de passe doit faire au moins 8 caractères.',
      exists: 'Un compte existe déjà avec cette adresse. Connecte-toi.',
      captcha: 'Confirme que tu n\'es pas un robot.',
      config: 'Service momentanément indisponible. Réessaie plus tard.',
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.remove('show');
      const token = window.turnstile ? window.turnstile.getResponse(regWid) : '';
      if (!token) { msg.textContent = errors.captcha; msg.classList.add('show'); return; }
      btn.disabled = true; btn.textContent = 'Création…';
      try {
        const body = { name: form.name.value, email: form.email.value, password: form.password.value, turnstileToken: token };
        const r = await fetch('/api/auth/register', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        const d = await r.json();
        if (d.ok) { location.href = '/academy/compte/?bienvenue=1'; return; }
        msg.textContent = errors[d.error] || 'Une erreur est survenue.';
        msg.classList.add('show');
        if (window.turnstile) window.turnstile.reset(regWid);
      } catch { msg.textContent = 'Connexion impossible. Vérifie ton réseau.'; msg.classList.add('show'); }
      btn.disabled = false; btn.textContent = 'Créer mon compte';
    });
  }
  document.addEventListener('astro:page-load', bind);
</script>
