---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const books = (await getCollection('books')).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
const grads = [
  'linear-gradient(150deg,#0e8074,#0b3f39)',
  'linear-gradient(150deg,#12a594,#0e6b62)',
  'linear-gradient(150deg,#e0a400,#a06b00)',
  'linear-gradient(150deg,#0b6e64,#08423b)',
];
---

<BaseLayout title="Livres" description="Découvrez, lisez et téléchargez une sélection de livres.">
  <section class="banner">
    <div class="wrap">
      <span class="eyebrow">La bibliothèque</span>
      <h1>Découvrez, Lisez et Téléchargez</h1>
    </div>
  </section>

  <div class="section wrap">
    <p style="color:var(--muted);font-size:1.08rem;max-width:640px;margin-top:0">
      Une sélection de lectures pour nourrir ta curiosité et passer à l'action.
    </p>

    {books.length ? (
      <div class="books-grid">
        {books.map((b, i) => (
          <article class="book-card reveal">
            <div class="book-cover" style={b.data.cover ? '' : `background:${grads[i % grads.length]}`}>
              {b.data.cover ? <img src={b.data.cover} alt={b.data.title} loading="lazy" /> : <Icon name="book" size={40} />}
              {!b.data.available && <span class="book-soon">Bientôt</span>}
            </div>
            <div class="book-body">
              <h3>{b.data.title}</h3>
              {b.data.author && <div class="book-author">{b.data.author}</div>}
              {b.data.description && <p class="book-desc">{b.data.description}</p>}
              <div class="book-actions">
                {b.data.available && b.data.file && (
                  <a class="book-btn" href={b.data.file} download><Icon name="download" size={16} /> Télécharger</a>
                )}
                {b.data.available && b.data.readUrl && (
                  <a class="book-btn ghost" href={b.data.readUrl} target="_blank" rel="noopener noreferrer"><Icon name="book" size={16} /> Lire</a>
                )}
                {!b.data.available && <span class="book-btn disabled">Bientôt disponible</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p style="color:var(--muted)">📚 La bibliothèque est en construction — reviens bientôt.</p>
    )}
  </div>
</BaseLayout>
