---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, PILLARS } from '../consts';
---

<BaseLayout title="À propos" description="Tutoria News, média éducatif francophone fondé par Moïse Matondo.">
  <section class="banner">
    <div class="wrap">
      <span class="eyebrow">Vision pour l'avenir</span>
      <h1>À propos de nous</h1>
    </div>
  </section>

  <div class="wrap" style="max-width:960px;padding:44px 20px 10px">
    <div class="duo">
      <div class="info-card reveal">
        <span class="ic"><Icon name="growth" /></span>
        <h3>Notre philosophie</h3>
        <p>
          <strong>Tutoria News</strong> — de <em>Tutoriel</em> et <em>Orientation</em> — est bien
          plus qu'un magazine : une communauté dédiée à l'éducation, l'inspiration et l'innovation.
          Notre promesse tient en trois verbes : <strong>tu lis, tu comprends, tu appliques.</strong>
        </p>
      </div>
      <div class="info-card yellow reveal">
        <span class="ic"><Icon name="health" /></span>
        <h3>Notre mission</h3>
        <p>
          Fournir des contenus fiables et engageants pour permettre à chacun de grandir, d'apprendre
          et de réussir. Chaque article part d'une situation réelle du quotidien et se termine par
          une action concrète, applicable dès aujourd'hui.
        </p>
      </div>
    </div>

    <h2 class="section-title" style="margin-top:26px">Nos quatre piliers</h2>
    <div class="pillars">
      {PILLARS.map((p) => (
        <a class="pillar reveal" href={`/categorie/${p.slug}/`}>
          <span class="ic" style={`background:${p.color}`}><Icon name={p.icon} /></span>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
          <div class="bar" style={`background:${p.color}`}></div>
        </a>
      ))}
    </div>

    <div class="info-card reveal" style="margin:30px 0 20px;text-align:center">
      <p style="font-size:1.05rem;color:var(--ink)">
        Fondé par <strong>{SITE.author}</strong>. Rejoins-nous sur
        <a href="https://www.tiktok.com/@tutorianews">TikTok</a> et
        <a href="https://www.youtube.com/@TutoriaNews">YouTube</a> — et fais partie du voyage. 🚀
      </p>
    </div>
  </div>
</BaseLayout>
