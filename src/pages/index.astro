---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { PILLARS, catSlugOf, youtubeId } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const heroBig = posts.slice(0, 4); // grande vedette rotative (slider)
const heroSide = posts.slice(4, 8); // 4 petites cartes
const byPillar = PILLARS.map((p) => ({
  ...p,
  items: posts.filter((x) => catSlugOf(x.data) === p.slug).slice(0, 4),
}));
const videos = (await getCollection('videos')).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<BaseLayout>
  <div class="home-hero">
    <div class="hero-mosaic">
      <div class="hero-main">
        <HeroSlider posts={heroBig} />
      </div>
      <div class="hero-side">
        {heroSide.map((p) => (
          <a class="mini-card" href={`/blog/${p.id}/`}>
            {p.data.cover && <img src={p.data.cover} alt={p.data.title} loading="lazy" />}
            <div class="veil"></div>
            <div class="mc-content">
              <span class="cat">{p.data.category}</span>
              <h3>{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  {byPillar.map((p) =>
    p.items.length > 0 ? (
      <section class="home-section">
        <div class="sec-head">
          <h2 class="section-title" style={`--dot:${p.color}`}>{p.name}</h2>
          <a class="see-all" href={`/categorie/${p.slug}/`}>Voir tout <Icon name="arrowRight" /></a>
        </div>
        <div class="cards-4">
          {p.items.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    ) : null
  )}

  {videos.length > 0 && (
    <section class="home-section">
      <div class="sec-head">
        <h2 class="section-title">Nos vidéos</h2>
        <a class="see-all" href="https://www.youtube.com/@TutoriaNews" target="_blank" rel="noopener noreferrer">Voir la chaîne <Icon name="arrowRight" /></a>
      </div>
      <div class="videos-grid">
        {videos.map((v) => {
          const id = youtubeId(v.data.youtube);
          return id ? (
            <div class="video-item">
              <div class="yt-facade" data-id={id}>
                <img loading="lazy" src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={v.data.title} />
                <button class="yt-play" aria-label="Lire la vidéo"></button>
              </div>
              <div class="yt-title">{v.data.title}</div>
            </div>
          ) : null;
        })}
      </div>
    </section>
  )}

  <section class="band">
    <div class="section wrap">
      <h2 class="section-title center">Nos rubriques</h2>
      <div class="pillars">
        {PILLARS.map((p) => (
          <a class="pillar reveal" href={`/categorie/${p.slug}/`}>
            <span class="ic" style={`background:${p.color}`}><Icon name={p.icon} /></span>
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            <div class="bar" style={`background:${p.color}`}></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="nl-home reveal"><Newsletter /></div>
  </section>
</BaseLayout>
