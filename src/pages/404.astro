---
import AcademyLayout from '../layouts/AcademyLayout.astro';
import { PILLARS } from '../consts';

const PH: Record<string, string> = {
  'sante-bien-etre': 'fa-solid fa-heart-pulse',
  'developpement-personnel': 'fa-solid fa-arrow-trend-up',
  'finance-investissement': 'fa-solid fa-coins',
  'technologie-emergente': 'fa-solid fa-microchip',
};
const GRAD: Record<string, string[]> = {
  'sante-bien-etre': ['#12A594', '#0B6E64'],
  'developpement-personnel': ['#E0A400', '#A9760A'],
  'finance-investissement': ['#0E8074', '#0A3F3A'],
  'technologie-emergente': ['#19B7A0', '#0E8074'],
};
---

<AcademyLayout title="Page introuvable">
  <section class="ac-404">
    <span class="ac-eyebrow">Erreur 404</span>
    <h1 class="ac-display">Cette page a pris <span class="ac-hl">un autre chemin.</span></h1>
    <p>La page que tu cherches n'existe pas ou a été déplacée. Reprends le fil par ici :</p>
    <div class="ac-404-cta">
      <a class="ac-btn ac-btn-primary" href="/academy/">Retour à l'accueil</a>
      <a class="ac-btn ac-btn-ghost" href="/academy/bibliotheque/">Voir la bibliothèque</a>
    </div>
  </section>

  <section class="ac-features ac-404-doms">
    {PILLARS.map((p) => {
      const g = GRAD[p.slug] || ['#0E8074', '#0A3F3A'];
      return (
        <a class="ac-feat" href={`/academy/bibliotheque/#${p.slug}`} style={`--c1:${g[0]};--c2:${g[1]}`}>
          <span class="ac-feat-ic"><i class={PH[p.slug]} aria-hidden="true"></i></span>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
          <span class="ac-feat-go">Explorer →</span>
        </a>
      );
    })}
  </section>
</AcademyLayout>

<style>
  .ac-404 { text-align: center; max-width: 640px; margin: 0 auto; padding: 64px 0 36px; }
  .ac-404 .ac-eyebrow { display: block; margin-bottom: 14px; }
  .ac-404 h1 { font-size: clamp(2rem, 4.6vw, 3rem); letter-spacing: -0.03em; line-height: 1.04; margin: 0 0 16px; }
  .ac-404 p { color: var(--ac-ink-soft); font-size: 1.1rem; line-height: 1.6; margin: 0 0 26px; }
  .ac-404-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .ac-404-doms { margin: 8px 0 24px; }
</style>
