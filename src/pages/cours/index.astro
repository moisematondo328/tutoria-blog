---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLARS, pillarByName } from '../../consts';

const courses = (await getCollection('courses', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const lessonCount = (courseId: string) => lessons.filter((l) => l.data.course === courseId).length;
const byPillar = PILLARS.map((p) => ({
  pillar: p,
  list: courses.filter((c) => pillarByName(c.data.category)?.slug === p.slug),
}));
---

<BaseLayout title="Cours & formations" description="Des parcours structurés pour apprendre pas à pas, animés par nos experts. Tu lis, tu comprends, tu appliques.">
  <div class="breadcrumb"><div class="wrap"><a href="/">Accueil</a> » Cours</div></div>

  <div class="wrap course-intro">
    <h1 class="section-title">Cours & formations</h1>
    <p class="lead">Ici, on ne fait pas que lire : on apprend par étapes. Chaque parcours est structuré et animé par un expert de son domaine. Commence gratuitement, progresse à ton rythme.</p>
  </div>

  <div class="wrap">
    {byPillar.map(({ pillar, list }) => list.length > 0 && (
      <section class="pillar-block">
        <h2 class="pillar-title" style={`border-color:${pillar.color}`}>{pillar.name}</h2>
        <div class="course-grid">
          {list.map((c) => (
            <a class="course-card" href={`/cours/${c.id}/`}>
              <div class="cc-cover" style={`background:linear-gradient(135deg, ${pillar.color}, var(--teal-d))`}>
                {c.data.cover
                  ? <img src={c.data.cover} alt={c.data.title} />
                  : <span class="cc-ph">{c.data.title}</span>}
                <span class="cc-level">{c.data.level}</span>
              </div>
              <div class="cc-body">
                <h3>{c.data.title}</h3>
                <p>{c.data.excerpt}</p>
                <div class="cc-meta">
                  <span>{lessonCount(c.id)} leçon{lessonCount(c.id) > 1 ? 's' : ''}</span>
                  {c.data.expert && <span>· {c.data.expert}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
    {courses.length === 0 && <p style="color:var(--muted)">Les premiers cours arrivent bientôt.</p>}
  </div>
</BaseLayout>

<style>
  .course-intro { margin-bottom: 8px; }
  .lead { color: var(--muted); max-width: 720px; font-size: 1.05rem; line-height: 1.6; }
  .pillar-block { margin: 34px 0; }
  .pillar-title { font-size: 1.25rem; border-left: 5px solid var(--teal); padding-left: 12px; margin: 0 0 18px; }
  .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .course-card { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
  .course-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,.10); }
  .cc-cover { position: relative; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .cc-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cc-ph { color: #fff; font-weight: 800; font-size: 1.1rem; text-align: center; line-height: 1.25; text-shadow: 0 2px 8px rgba(0,0,0,.25); }
  .cc-level { position: absolute; top: 10px; right: 10px; background: #FDD200; color: #0B4A44; font-weight: 700; font-size: .72rem; padding: 3px 9px; border-radius: 999px; }
  .cc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
  .cc-body h3 { margin: 0; font-size: 1.05rem; line-height: 1.3; }
  .cc-body p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.45; }
  .cc-meta { margin-top: 6px; color: var(--teal); font-weight: 600; font-size: .82rem; }
</style>
