---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { pillarByName } from '../../../consts';

export async function getStaticPaths() {
  const courses = await getCollection('courses', ({ data }) => !data.draft);
  return courses.map((course) => ({ params: { course: course.id }, props: { course } }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const lessons = (await getCollection('lessons', ({ data }) => !data.draft && data.course === course.id)).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
const slugOf = (id: string) => id.split('/').pop();
const pillar = pillarByName(course.data.category);
const color = pillar?.color || 'var(--teal)';
const first = lessons[0];
---

<BaseLayout title={course.data.title} description={course.data.excerpt} image={course.data.cover}>
  <div class="breadcrumb"><div class="wrap"><a href="/">Accueil</a> » <a href="/cours/">Cours</a> » {course.data.title}</div></div>

  <div class="wrap">
    <header class="course-head" style={`--acc:${color}`}>
      <span class="badge-inline" style={`background:${color}`}>{course.data.category}</span>
      <h1>{course.data.title}</h1>
      <p class="excerpt">{course.data.excerpt}</p>
      <div class="course-meta">
        <span>{course.data.level}</span>
        <span>{lessons.length} leçon{lessons.length > 1 ? 's' : ''}</span>
        {course.data.expert && <span>Animé par {course.data.expert}</span>}
      </div>
      {first && <a class="btn-start" href={`/cours/${course.id}/${slugOf(first.id)}/`}>Commencer le cours</a>}
    </header>

    <div class="course-body prose"><Content /></div>

    <section class="lessons">
      <h2>Programme</h2>
      <ol class="lesson-list">
        {lessons.map((l, i) => (
          <li>
            <a href={`/cours/${course.id}/${slugOf(l.id)}/`}>
              <span class="num">{i + 1}</span>
              <span class="ltitle">{l.data.title}</span>
              {l.data.premium && <span class="lock">Premium</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .course-head { background: var(--card); border: 1px solid var(--line); border-left: 6px solid var(--acc); border-radius: 16px; padding: 26px 28px; margin: 6px 0 24px; }
  .course-head h1 { margin: 12px 0 8px; font-size: 1.9rem; line-height: 1.2; }
  .badge-inline { color: #fff; font-weight: 700; font-size: .78rem; padding: 4px 12px; border-radius: 999px; text-decoration: none; }
  .excerpt { color: var(--muted); font-size: 1.05rem; line-height: 1.55; margin: 0 0 14px; max-width: 720px; }
  .course-meta { display: flex; flex-wrap: wrap; gap: 16px; color: var(--teal); font-weight: 600; font-size: .9rem; margin-bottom: 18px; }
  .btn-start { display: inline-block; background: var(--teal); color: #fff; font-weight: 700; padding: 12px 26px; border-radius: 12px; text-decoration: none; }
  .btn-start:hover { background: var(--teal-d); }
  .course-body { margin-bottom: 26px; }
  .lessons h2 { font-size: 1.3rem; margin: 0 0 14px; }
  .lesson-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .lesson-list a { display: flex; align-items: center; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .lesson-list a:hover { border-color: var(--teal); transform: translateX(3px); }
  .num { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 50%; background: var(--teal); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .ltitle { flex: 1; font-weight: 600; }
  .lock { background: #FDD200; color: #0B4A44; font-weight: 700; font-size: .72rem; padding: 3px 9px; border-radius: 999px; }
</style>
